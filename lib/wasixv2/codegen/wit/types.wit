  // ==== System V IPC ====

  /// IPC permissions (asm-generic `struct ipc64_perm`). The zero-length `__pad1` is omitted.
  /// @c(struct ipc_perm)
  /// @size(36)
  /// @align(4)
  record ipc64-perm {
    key: key,
    uid: uid,
    gid: gid,
    cuid: uid,
    cgid: gid,
    mode: mode,
    /// musl: `int __ipc_perm_seq`, covering `seq` and `__pad2` (little-endian).
    /// @c-name(__ipc_perm_seq)
    seq: u16,
    /// No C assert: part of musl's 32-bit `__ipc_perm_seq`.
    /// @c-skip
    pad2: u16,
    /// musl: `__pad1`.
    /// @c-name(__pad1)
    unused1: ulong,
    /// musl: `__pad2`.
    /// @c-name(__pad2)
    unused2: ulong,
  }

  /// `msgctl` buffer (asm-generic `struct msqid64_ds`, times split into low/high words).
  /// musl's 112-byte `struct msqid_ds` differs; it converts.
  /// @kernel-only
  /// @size(88)
  /// @align(4)
  record msqid64-ds {
    msg-perm: ipc64-perm,
    msg-stime: ulong,
    msg-stime-high: ulong,
    msg-rtime: ulong,
    msg-rtime-high: ulong,
    msg-ctime: ulong,
    msg-ctime-high: ulong,
    msg-cbytes: ulong,
    msg-qnum: ulong,
    msg-qbytes: ulong,
    msg-lspid: pid,
    msg-lrpid: pid,
    /// @c-name(__unused4)
    unused4: ulong,
    /// @c-name(__unused5)
    unused5: ulong,
  }

  /// `semctl` buffer (asm-generic `struct semid64_ds`), passed through the `semun` argument.
  /// @kernel-only
  /// @size(64)
  /// @align(4)
  record semid64-ds {
    sem-perm: ipc64-perm,
    sem-otime: ulong,
    sem-otime-high: ulong,
    sem-ctime: ulong,
    sem-ctime-high: ulong,
    sem-nsems: ulong,
    /// @c-name(__unused3)
    unused3: ulong,
    /// @c-name(__unused4)
    unused4: ulong,
  }

  /// `shmctl` buffer (asm-generic `struct shmid64_ds`).
  /// @kernel-only
  /// @size(84)
  /// @align(4)
  record shmid64-ds {
    shm-perm: ipc64-perm,
    shm-segsz: usize,
    shm-atime: ulong,
    shm-atime-high: ulong,
    shm-dtime: ulong,
    shm-dtime-high: ulong,
    shm-ctime: ulong,
    shm-ctime-high: ulong,
    shm-cpid: pid,
    shm-lpid: pid,
    shm-nattch: ulong,
    /// @c-name(__unused4)
    unused4: ulong,
    /// @c-name(__unused5)
    unused5: ulong,
  }

  /// `semop`/`semtimedop_time64` operation (`struct sembuf`).
  /// @c(struct sembuf)
  /// @size(6)
  /// @align(2)
  record sembuf {
    sem-num: u16,
    sem-op: s16,
    /// `sem-flags` bits (plus `IPC_NOWAIT`).
    sem-flg: s16,
  }

  /// Message buffer header (`struct msgbuf`); `msgsz` bytes of text start at offset 4.
  /// @c(struct msgbuf)
  /// @size(8)
  /// @align(4)
  record msgbuf {
    mtype: slong,
    mtext: list<u8, 1>,
  }

  /// POSIX message queue attributes (`struct mq_attr`).
  /// @c(struct mq_attr)
  /// @size(32)
  /// @align(4)
  record mq-attr {
    mq-flags: slong,
    mq-maxmsg: slong,
    mq-msgsize: slong,
    mq-curmsgs: slong,
    /// musl: `__unused`.
    /// @c-name(__unused)
    reserved: list<slong, 4>,
  }

  /// Special SysV IPC keys (`linux/ipc.h`).
  /// @repr(s32)
  /// @c(key_t)
  enum ipc-key {
    /// @value(0)
    ipc-private,
  }

  /// `msgget`/`semget`/`shmget` flags (`IPC_*`; low 9 bits carry permissions).
  /// @repr(u32)
  /// @c(int)
  flags ipc-flags {
    /// @value(0x200)
    ipc-creat,
    /// @value(0x400)
    ipc-excl,
    /// @value(0x800)
    ipc-nowait,
    /// @value(0x1000)
    ipc-dipc,
    /// @value(0x2000)
    ipc-own,
  }

  /// `msgctl`/`semctl`/`shmctl` commands (`linux/ipc.h`, `msg.h`, `sem.h`, `shm.h`).
  /// On most 32-bit arches `IPC_64` is ORed in; musl riscv32 (and wasixv2) passes commands without it.
  /// @repr(s32)
  /// @c(int)
  enum ipc-cmd {
    /// @value(0)
    ipc-old,
    /// @value(0)
    ipc-rmid,
    /// @value(1)
    ipc-set,
    /// @value(2)
    /// No C assert: musl ORs `IPC_TIME64` (0x100) into `IPC_STAT` on time64 archs and translates.
    /// @c-skip
    ipc-stat,
    /// @value(3)
    ipc-info,
    /// @value(11)
    getpid,
    /// @value(11)
    /// No C assert: musl ORs `IPC_TIME64` (0x100) into `MSG_STAT` on time64 archs and translates.
    /// @c-skip
    msg-stat,
    /// @value(11)
    shm-lock,
    /// @value(12)
    getval,
    /// @value(12)
    msg-info,
    /// @value(12)
    shm-unlock,
    /// @value(13)
    getall,
    /// @value(13)
    /// No C assert: musl ORs `IPC_TIME64` (0x100) into `SHM_STAT` on time64 archs and translates.
    /// @c-skip
    shm-stat,
    /// @value(14)
    getncnt,
    /// @value(14)
    shm-info,
    /// @value(15)
    getzcnt,
    /// @value(16)
    setval,
    /// @value(17)
    setall,
    /// @value(18)
    /// No C assert: musl ORs `IPC_TIME64` (0x100) into `SEM_STAT` on time64 archs and translates.
    /// @c-skip
    sem-stat,
    /// @value(19)
    sem-info,
    /// @value(256)
    /// No C assert: musl's internal `IPC_64` is 0 on riscv32 and wasm32; asm-generic kernels
    /// always use the 64-bit IPC structs, so musl passes no flag.
    /// @c-skip
    ipc-64,
  }

  /// `msgrcv` flags (`linux/msg.h`).
  /// @repr(u32)
  /// @c(int)
  flags msgrcv-flags {
    /// @value(0x1000)
    msg-noerror,
    /// @value(0x2000)
    msg-except,
    /// @value(0x4000)
    msg-copy,
  }

  /// `sembuf.sem_flg` bits (`linux/sem.h`).
  /// @repr(u32)
  flags sem-flags {
    /// @value(0x1000)
    sem-undo,
  }

  /// `shmget`/`shmat` flags (`linux/shm.h`).
  /// @repr(u32)
  /// @c(int)
  flags shm-flags {
    /// @value(0x80)
    shm-w,
    /// @value(0x100)
    shm-r,
    /// @value(0x800)
    shm-hugetlb,
    /// @value(0x1000)
    shm-noreserve,
    /// @value(0x1000)
    shm-rdonly,
    /// @value(0x2000)
    shm-rnd,
    /// @value(0x4000)
    shm-remap,
    /// @value(0x8000)
    shm-exec,
  }

  // ==== Asynchronous I/O and io_uring ====

  /// Linux native AIO control block (`struct iocb`). Pointers are zero-extended `u64`s.
  /// @kernel-only
  /// @size(64)
  /// @align(8)
  record iocb {
    aio-data: u64,
    aio-key: u32,
    aio-rw-flags: rwf,
    aio-lio-opcode: u16,
    aio-reqprio: s16,
    aio-fildes: u32,
    aio-buf: u64,
    aio-nbytes: u64,
    aio-offset: s64,
    aio-reserved2: u64,
    aio-flags: u32,
    aio-resfd: u32,
  }

  /// Linux native AIO completion (`struct io_event`).
  /// @kernel-only
  /// @size(32)
  /// @align(8)
  record io-event {
    data: u64,
    obj: u64,
    res: s64,
    res2: s64,
  }

  /// 6th argument of `io_pgetevents_time64` (`struct __aio_sigset`).
  /// @kernel-only
  /// @size(8)
  /// @align(4)
  record aio-sigset {
    sigmask: const-sigset-ptr,
    sigsetsize: usize,
  }

  /// Submission ring offsets (`struct io_sqring_offsets`).
  /// @kernel-only
  /// @size(40)
  /// @align(8)
  record io-sqring-offsets {
    head: u32,
    tail: u32,
    ring-mask: u32,
    ring-entries: u32,
    %flags: u32,
    dropped: u32,
    array: u32,
    resv1: u32,
    user-addr: u64,
  }

  /// Completion ring offsets (`struct io_cqring_offsets`).
  /// @kernel-only
  /// @size(40)
  /// @align(8)
  record io-cqring-offsets {
    head: u32,
    tail: u32,
    ring-mask: u32,
    ring-entries: u32,
    overflow: u32,
    cqes: u32,
    %flags: u32,
    resv1: u32,
    user-addr: u64,
  }

  /// `io_uring_setup` parameters (`struct io_uring_params`).
  /// @kernel-only
  /// @size(120)
  /// @align(8)
  record io-uring-params {
    sq-entries: u32,
    cq-entries: u32,
    %flags: u32,
    sq-thread-cpu: u32,
    sq-thread-idle: u32,
    features: u32,
    wq-fd: u32,
    resv: list<u32, 3>,
    sq-off: io-sqring-offsets,
    cq-off: io-cqring-offsets,
  }

  /// `io_uring_enter` extended argument with `IORING_ENTER_EXT_ARG` (`struct io_uring_getevents_arg`).
  /// @kernel-only
  /// @size(24)
  /// @align(8)
  record io-uring-getevents-arg {
    sigmask: u64,
    sigmask-sz: u32,
    min-wait-usec: u32,
    ts: u64,
  }

  // ==== Terminals and ioctl requests ====

  /// Kernel terminal attributes for `TCGETS`/`TCSETS*` (asm-generic `struct termios`, `NCCS` 19).
  /// musl's 60-byte `struct termios` is a prefix-compatible superset passed directly.
  /// @kernel-only
  /// @size(36)
  /// @align(4)
  record termios {
    c-iflag: termios-iflag,
    c-oflag: termios-oflag,
    c-cflag: termios-cflag,
    c-lflag: termios-lflag,
    c-line: u8,
    c-cc: list<u8, 19>,
  }

  /// Terminal attributes with explicit speeds for `TCGETS2`/`TCSETS*2` (`struct termios2`).
  /// @kernel-only
  /// @size(44)
  /// @align(4)
  record termios2 {
    c-iflag: termios-iflag,
    c-oflag: termios-oflag,
    c-cflag: termios-cflag,
    c-lflag: termios-lflag,
    c-line: u8,
    c-cc: list<u8, 19>,
    c-ispeed: u32,
    c-ospeed: u32,
  }

  /// Terminal window size for `TIOCGWINSZ`/`TIOCSWINSZ` (`struct winsize`).
  /// @c(struct winsize)
  /// @size(8)
  /// @align(2)
  record winsize {
    ws-row: u16,
    ws-col: u16,
    ws-xpixel: u16,
    ws-ypixel: u16,
  }

