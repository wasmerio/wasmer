  flags prot-flags {
    /// @value(0x0)
    prot-none,
    /// @value(0x1)
    prot-read,
    /// @value(0x2)
    prot-write,
    /// @value(0x4)
    prot-exec,
    /// @value(0x8)
    prot-sem,
    /// @value(0x1000000)
    prot-growsdown,
    /// @value(0x2000000)
    prot-growsup,
  }

  /// `mmap2` flags (`MAP_*`, `asm-generic/mman*.h`, `linux/mman.h`).
  /// `MAP_SHARED`/`MAP_PRIVATE`/`MAP_SHARED_VALIDATE` are values of the `MAP_TYPE` field;
  /// `MAP_HUGE_*` encode log2(page size) in bits 26..31.
  /// @repr(u32)
  /// @c(int)
  flags map-flags {
    /// @value(0x0)
    map-file,
    /// @value(0x1)
    map-shared,
    /// @value(0x2)
    map-private,
    /// @value(0x3)
    map-shared-validate,
    /// @value(0x8)
    map-droppable,
    /// @value(0xf)
    map-type,
    /// @value(0x10)
    map-fixed,
    /// @value(0x20)
    map-anonymous,
    /// @value(0x100)
    map-growsdown,
    /// @value(0x800)
    map-denywrite,
    /// @value(0x1000)
    map-executable,
    /// @value(0x2000)
    map-locked,
    /// @value(0x4000)
    map-noreserve,
    /// @value(0x8000)
    map-populate,
    /// @value(0x10000)
    map-nonblock,
    /// @value(0x20000)
    map-stack,
    /// @value(0x40000)
    map-hugetlb,
    /// @value(0x80000)
    map-sync,
    /// @value(0x100000)
    map-fixed-noreplace,
    /// @value(0x4000000)
    map-uninitialized,
    /// @value(0x38000000)
    map-huge-16kb,
    /// @value(0x40000000)
    map-huge-64kb,
    /// @value(0x4c000000)
    map-huge-512kb,
    /// @value(0x50000000)
    map-huge-1mb,
    /// @value(0x54000000)
    map-huge-2mb,
    /// @value(0x5c000000)
    map-huge-8mb,
    /// @value(0x60000000)
    map-huge-16mb,
    /// @value(0x64000000)
    map-huge-32mb,
    /// @value(0x70000000)
    map-huge-256mb,
    /// @value(0x74000000)
    map-huge-512mb,
    /// @value(0x78000000)
    map-huge-1gb,
    /// @value(0x7c000000)
    map-huge-2gb,
    /// @value(0x88000000)
    map-huge-16gb,
  }

  /// Shift/mask of the huge page size field in `mmap2` and `memfd_create` flags.
  /// @repr(u32)
  enum hugetlb-encoding {
    /// @value(26)
    map-huge-shift,
    /// @value(26)
    mfd-huge-shift,
    /// @value(63)
    map-huge-mask,
    /// @value(63)
    mfd-huge-mask,
  }

  /// `msync` flags (`asm-generic/mman-common.h`).
  /// @repr(u32)
  /// @c(int)
  flags msync-flags {
    /// @value(0x1)
    ms-async,
    /// @value(0x2)
    ms-invalidate,
    /// @value(0x4)
    ms-sync,
  }

  /// `madvise`/`process_madvise` advice (`asm-generic/mman-common.h`).
  /// @repr(s32)
  /// @c(int)
  enum madvise-advice {
    /// @value(0)
    madv-normal,
    /// @value(1)
    madv-random,
    /// @value(2)
    madv-sequential,
    /// @value(3)
    madv-willneed,
    /// @value(4)
    madv-dontneed,
    /// @value(8)
    madv-free,
    /// @value(9)
    madv-remove,
    /// @value(10)
    madv-dontfork,
    /// @value(11)
    madv-dofork,
    /// @value(12)
    madv-mergeable,
    /// @value(13)
    madv-unmergeable,
    /// @value(14)
    madv-hugepage,
    /// @value(15)
    madv-nohugepage,
    /// @value(16)
    madv-dontdump,
    /// @value(17)
    madv-dodump,
    /// @value(18)
    madv-wipeonfork,
    /// @value(19)
    madv-keeponfork,
    /// @value(20)
    madv-cold,
    /// @value(21)
    madv-pageout,
    /// @value(22)
    madv-populate-read,
    /// @value(23)
    madv-populate-write,
    /// @value(24)
    madv-dontneed-locked,
    /// @value(25)
    madv-collapse,
    /// @value(100)
    madv-hwpoison,
    /// @value(101)
    madv-soft-offline,
    /// @value(102)
    madv-guard-install,
    /// @value(103)
    madv-guard-remove,
  }

  /// `mlockall` flags (`asm-generic/mman.h`).
  /// @repr(u32)
  /// @c(int)
  flags mcl-flags {
    /// @value(0x1)
    mcl-current,
    /// @value(0x2)
    mcl-future,
    /// @value(0x4)
    mcl-onfault,
  }

  /// `mlock2` flags (`asm-generic/mman-common.h`).
  /// @repr(u32)
  /// @c(int)
  flags mlock-flags {
    /// @value(0x1)
    mlock-onfault,
  }

  /// `mremap` flags (`linux/mman.h`).
  /// @repr(u32)
  /// @c(int)
  flags mremap-flags {
    /// @value(0x1)
    mremap-maymove,
    /// @value(0x2)
    mremap-fixed,
    /// @value(0x4)
    mremap-dontunmap,
  }

  /// `vm.overcommit_memory` modes (`linux/mman.h`).
  /// @repr(s32)
  enum overcommit-mode {
    /// @value(0)
    overcommit-guess,
    /// @value(1)
    overcommit-always,
    /// @value(2)
    overcommit-never,
  }

  /// `pkey_alloc` access rights (`asm-generic/mman-common.h`).
  /// @repr(u32)
  flags pkey-access {
    /// @value(0x0)
    pkey-unrestricted,
    /// @value(0x1)
    pkey-disable-access,
    /// @value(0x2)
    pkey-disable-write,
    /// @value(0x3)
    pkey-access-mask,
  }

  /// `memfd_create` flags (`linux/memfd.h`).
  /// @repr(u32)
  /// @c(unsigned)
  flags memfd-flags {
    /// @value(0x1)
    mfd-cloexec,
    /// @value(0x2)
    mfd-allow-sealing,
    /// @value(0x4)
    mfd-hugetlb,
    /// @value(0x8)
    mfd-noexec-seal,
    /// @value(0x10)
    mfd-exec,
  }

  // ==== Clocks and timers ====

  /// Time64 timespec (`struct __kernel_timespec`). The `time64` syscalls all use it.
  ///
  /// musl's `struct timespec` has a 32-bit `long tv_nsec` at offset 8 followed by 4 bytes of
  /// padding that it does not initialise. The kernel truncates `tv_nsec` to 32 bits on 32-bit
  /// ABIs, so on input hosts must read only the low 32 bits; on output they write the full
  /// 64-bit value (high half zero).
  /// @c(struct timespec)
  /// @size(16)
  /// @align(8)
  record kernel-timespec {
    tv-sec: time,
    tv-nsec: s64,
  }

  /// Time64 interval timer value (`struct __kernel_itimerspec`).
  /// @c(struct itimerspec)
  /// @size(32)
  /// @align(8)
  record kernel-itimerspec {
    it-interval: kernel-timespec,
    it-value: kernel-timespec,
  }

  /// Legacy 32-bit `timeval` (`struct __kernel_old_timeval`), used by `getitimer`, `setitimer`,
  /// `getrusage` and `waitid`. musl's 64-bit `struct timeval` does not match; it converts.
  /// @kernel-only
  /// @size(8)
  /// @align(4)
  record kernel-old-timeval {
    tv-sec: slong,
    tv-usec: slong,
  }

  /// Legacy 32-bit interval timer (`struct __kernel_old_itimerval`).
  /// @kernel-only
  /// @size(16)
  /// @align(4)
  record kernel-old-itimerval {
    it-interval: kernel-old-timeval,
    it-value: kernel-old-timeval,
  }

  /// Time64 `timeval` for `SO_RCVTIMEO_NEW`/`SO_SNDTIMEO_NEW` (`struct __kernel_sock_timeval`).
  /// @c(struct timeval)
  /// @size(16)
  /// @align(8)
  record kernel-sock-timeval {
    tv-sec: s64,
    tv-usec: s64,
  }

  /// `timeval` embedded in `kernel-timex` (`struct __kernel_timex_timeval`).
  /// @kernel-only
  /// @size(16)
  /// @align(8)
  record kernel-timex-timeval {
    tv-sec: time,
    tv-usec: s64,
  }

  /// Time64 `timex` for `clock_adjtime64` (`struct __kernel_timex`).
  /// musl's `struct timex` differs; it converts. The `pad*` fields are anonymous `int :32`.
  /// @kernel-only
  /// @size(208)
  /// @align(8)
  record kernel-timex {
    modes: adjtimex-modes,
    pad0: s32,
    offset: s64,
    freq: s64,
    maxerror: s64,
    esterror: s64,
    status: timex-status,
    pad1: s32,
    constant: s64,
    precision: s64,
    tolerance: s64,
    time: kernel-timex-timeval,
    tick: s64,
    ppsfreq: s64,
    jitter: s64,
    shift: s32,
    pad2: s32,
    stabil: s64,
    jitcnt: s64,
    calcnt: s64,
    errcnt: s64,
    stbcnt: s64,
    tai: s32,
    pad3: list<s32, 11>,
  }

  /// Process times for `times` (`struct tms`, 32-bit `clock_t`).
  /// @c(struct tms)
  /// @size(16)
  /// @align(4)
  record tms {
    tms-utime: kernel-clock,
    tms-stime: kernel-clock,
    tms-cutime: kernel-clock,
    tms-cstime: kernel-clock,
  }

  /// Clock ids (`linux/time.h`). Negative ids encode per-process/thread CPU clocks.
  /// @repr(s32)
  /// @c(clockid_t)
  enum clock-id {
    /// @value(0)
    clock-realtime,
    /// @value(1)
    clock-monotonic,
    /// @value(2)
    clock-process-cputime-id,
    /// @value(3)
    clock-thread-cputime-id,
    /// @value(4)
    clock-monotonic-raw,
    /// @value(5)
    clock-realtime-coarse,
    /// @value(6)
    clock-monotonic-coarse,
    /// @value(7)
    clock-boottime,
    /// @value(8)
    clock-realtime-alarm,
    /// @value(9)
    clock-boottime-alarm,
    /// @value(10)
    clock-sgi-cycle,
    /// @value(11)
    clock-tai,
    /// @value(16)
    clock-aux,
    /// @value(16)
    max-clocks,
    /// @value(23)
    clock-aux-last,
  }

  /// `clock_nanosleep_time64`/`timer_settime64` flags (`linux/time.h`).
  /// @repr(u32)
  /// @c(int)
  flags timer-flags {
    /// @value(0x1)
    timer-abstime,
  }

  /// `getitimer`/`setitimer` timers (`linux/time.h`).
  /// @repr(s32)
  /// @c(int)
  enum itimer-which {
    /// @value(0)
    itimer-real,
    /// @value(1)
    itimer-virtual,
    /// @value(2)
    itimer-prof,
  }

  /// `timerfd_create` flags (`linux/timerfd.h`).
  /// @repr(u32)
  /// @c(int)
  flags timerfd-flags {
    /// @value(0x800)
    tfd-nonblock,
    /// @value(0x80000)
    tfd-cloexec,
  }

  /// `timerfd_settime64` flags (`linux/timerfd.h`).
  /// @repr(u32)
  /// @c(int)
  flags timerfd-settime-flags {
    /// @value(0x1)
    tfd-timer-abstime,
    /// @value(0x2)
    tfd-timer-cancel-on-set,
  }

  /// `kernel-timex.modes` (`ADJ_*`, `MOD_*`; `linux/timex.h`).
  /// @repr(u32)
  flags adjtimex-modes {
    /// @value(0x1)
    adj-offset,
    /// @value(0x1)
    mod-offset,
    /// @value(0x2)
    adj-frequency,
    /// @value(0x2)
    mod-frequency,
    /// @value(0x4)
    adj-maxerror,
    /// @value(0x4)
    mod-maxerror,
    /// @value(0x8)
    adj-esterror,
    /// @value(0x8)
    mod-esterror,
    /// @value(0x10)
    adj-status,
    /// @value(0x10)
    mod-status,
    /// @value(0x20)
    adj-timeconst,
    /// @value(0x20)
    mod-timeconst,
    /// @value(0x80)
    adj-tai,
    /// @value(0x80)
    mod-tai,
    /// @value(0x100)
    adj-setoffset,
    /// @value(0x1000)
    adj-micro,
    /// @value(0x1000)
    mod-micro,
    /// @value(0x2000)
    adj-nano,
    /// @value(0x2000)
    mod-nano,
    /// @value(0x4000)
    adj-tick,
    /// @value(0x8001)
    adj-offset-singleshot,
    /// @value(0xa001)
    adj-offset-ss-read,
  }

  /// `kernel-timex.status` (`STA_*`; `linux/timex.h`).
  /// @repr(u32)
  flags timex-status {
    /// @value(0x1)
    sta-pll,
    /// @value(0x2)
    sta-ppsfreq,
    /// @value(0x4)
    sta-ppstime,
    /// @value(0x8)
    sta-fll,
    /// @value(0x10)
    sta-ins,
    /// @value(0x20)
    sta-del,
    /// @value(0x40)
    sta-unsync,
    /// @value(0x80)
    sta-freqhold,
    /// @value(0x100)
    sta-ppssignal,
    /// @value(0x200)
    sta-ppsjitter,
    /// @value(0x400)
    sta-ppswander,
    /// @value(0x800)
    sta-ppserror,
    /// @value(0x1000)
    sta-clockerr,
    /// @value(0x2000)
    sta-nano,
    /// @value(0x4000)
    sta-mode,
    /// @value(0x8000)
    sta-clk,
    /// @value(0xff00)
    sta-ronly,
  }

  /// `clock_adjtime64` return values (`TIME_*`; `linux/timex.h`).
  /// @repr(s32)
  enum clock-state {
    /// @value(0)
    time-ok,
    /// @value(1)
    time-ins,
    /// @value(2)
    time-del,
    /// @value(3)
    time-oop,
    /// @value(4)
    time-wait,
    /// @value(5)
    time-bad,
    /// @value(5)
    time-error,
  }

  // ==== Sockets and networking ====

  /// Generic socket address (`struct sockaddr`).
  /// @c(struct sockaddr)
  /// @size(16)
  /// @align(2)
  record sockaddr {
    sa-family: sa-family,
    sa-data: list<u8, 14>,
  }

  /// Socket address storage (`struct __kernel_sockaddr_storage`).
  /// The kernel declares a union of `{ ss_family; __data[126] }` and a `void *` aligner; this is
  /// the same 128 bytes split the way musl's `struct sockaddr_storage` does.
  /// @c(struct sockaddr_storage)
  /// @size(128)
  /// @align(4)
  record sockaddr-storage {
    ss-family: sa-family,
    /// @c-name(__ss_padding)
    ss-padding: list<u8, 122>,
    /// @c-name(__ss_align)
    ss-align: ulong,
  }

  /// IPv4 address in network byte order (`struct in_addr`).
  /// @c(struct in_addr)
  /// @size(4)
  /// @align(4)
  record in-addr {
    s-addr: u32,
  }

  /// IPv6 address (`struct in6_addr`, a union `in6_u` in the kernel).
  /// @c(struct in6_addr)
  /// @union
  /// @size(16)
  /// @align(4)
  record in6-addr {
    /// @c-name(__in6_union.__s6_addr)
    u6-addr8: list<u8, 16>,
    /// @c-name(__in6_union.__s6_addr16)
    u6-addr16: list<u16, 8>,
    /// @c-name(__in6_union.__s6_addr32)
    u6-addr32: list<u32, 4>,
  }

  /// IPv4 socket address (`struct sockaddr_in`). Port and address are big-endian.
  /// @c(struct sockaddr_in)
  /// @size(16)
  /// @align(4)
  record sockaddr-in {
    sin-family: sa-family,
    sin-port: u16,
    sin-addr: in-addr,
    /// Kernel field `__pad`, `#define`d to `sin_zero`.
    sin-zero: list<u8, 8>,
  }

  /// IPv6 socket address (`struct sockaddr_in6`).
  /// @c(struct sockaddr_in6)
  /// @size(28)
  /// @align(4)
  record sockaddr-in6 {
    sin6-family: sa-family,
    sin6-port: u16,
    sin6-flowinfo: u32,
    sin6-addr: in6-addr,
    sin6-scope-id: u32,
  }

  /// Unix domain socket address (`struct sockaddr_un`).
  /// @c(struct sockaddr_un)
  /// @size(110)
  /// @align(2)
  record sockaddr-un {
    sun-family: sa-family,
    sun-path: list<u8, 108>,
  }

  /// Netlink socket address (`struct sockaddr_nl`).
  /// @kernel-only
  /// @size(12)
  /// @align(4)
  record sockaddr-nl {
    nl-family: sa-family,
    nl-pad: u16,
    nl-pid: u32,
    nl-groups: u32,
  }

  /// Link-layer socket address (`struct sockaddr_ll`).
  /// @c(struct sockaddr_ll)
  /// @size(20)
  /// @align(4)
  record sockaddr-ll {
    sll-family: sa-family,
    sll-protocol: u16,
    sll-ifindex: s32,
    sll-hatype: u16,
    sll-pkttype: u8,
    sll-halen: u8,
    sll-addr: list<u8, 8>,
  }

  /// `sendmsg`/`recvmsg` header (`struct user_msghdr`).
  /// @c(struct msghdr)
  /// @size(28)
  /// @align(4)
  record user-msghdr {
    msg-name: sockaddr-ptr,
    msg-namelen: s32,
    msg-iov: const-iovec-array,
    msg-iovlen: usize,
    msg-control: void-ptr,
    msg-controllen: usize,
    /// `msg-flags` bits.
    msg-flags: u32,
  }

  /// `sendmmsg`/`recvmmsg_time64` element (`struct mmsghdr`).
  /// @c(struct mmsghdr)
  /// @size(32)
  /// @align(4)
  record mmsghdr {
    msg-hdr: user-msghdr,
    msg-len: u32,
  }

  /// Control message header (`struct cmsghdr`). Data follows at offset 12; `CMSG_ALIGN` is 4.
  /// @c(struct cmsghdr)
  /// @size(12)
  /// @align(4)
  record cmsghdr {
    cmsg-len: usize,
    cmsg-level: s32,
    cmsg-type: s32,
  }

  /// `SO_PEERCRED`/`SCM_CREDENTIALS` payload (`struct ucred`).
  /// @c(struct ucred)
  /// @size(12)
  /// @align(4)
  record ucred {
    pid: pid,
    uid: uid,
    gid: gid,
  }

  /// `SO_LINGER` payload (`struct linger`).
  /// @c(struct linger)
  /// @size(8)
  /// @align(4)
  record linger {
    l-onoff: s32,
    l-linger: s32,
  }

  /// `IP_ADD_MEMBERSHIP` payload (`struct ip_mreq`).
  /// @c(struct ip_mreq)
  /// @size(8)
  /// @align(4)
  record ip-mreq {
    imr-multiaddr: in-addr,
    imr-interface: in-addr,
  }

  /// `IP_ADD_MEMBERSHIP`/`IP_MULTICAST_IF` payload with interface index (`struct ip_mreqn`).
  /// @c(struct ip_mreqn)
  /// @size(12)
  /// @align(4)
  record ip-mreqn {
    imr-multiaddr: in-addr,
    imr-address: in-addr,
    imr-ifindex: s32,
  }

  /// `IPV6_ADD_MEMBERSHIP` payload (`struct ipv6_mreq`).
  /// @c(struct ipv6_mreq)
  /// @size(20)
  /// @align(4)
  record ipv6-mreq {
    ipv6mr-multiaddr: in6-addr,
    /// musl (POSIX): `ipv6mr_interface`.
    /// @c-name(ipv6mr_interface)
    ipv6mr-ifindex: s32,
  }

  /// Address/protocol families (`AF_*`, `PF_*`).
  /// Not in the UAPI headers; values follow the kernel's `include/linux/socket.h`.
  /// @repr(s32)
  /// @c(int)
  enum address-family {
    /// @value(0)
    af-unspec,
    /// @value(0)
    pf-unspec,
    /// @value(1)
    af-file,
    /// @value(1)
    af-local,
    /// @value(1)
    af-unix,
    /// @value(1)
    pf-file,
    /// @value(1)
    pf-local,
    /// @value(1)
    pf-unix,
    /// @value(2)
    af-inet,
    /// @value(2)
    pf-inet,
    /// @value(3)
    af-ax25,
    /// @value(3)
    pf-ax25,
    /// @value(4)
    af-ipx,
    /// @value(4)
    pf-ipx,
    /// @value(5)
    af-appletalk,
    /// @value(5)
    pf-appletalk,
    /// @value(6)
    af-netrom,
    /// @value(6)
    pf-netrom,
    /// @value(7)
    af-bridge,
    /// @value(7)
    pf-bridge,
    /// @value(8)
    af-atmpvc,
    /// @value(8)
    pf-atmpvc,
    /// @value(9)
    af-x25,
    /// @value(9)
    pf-x25,
    /// @value(10)
    af-inet6,
    /// @value(10)
    pf-inet6,
    /// @value(11)
    af-rose,
    /// @value(11)
    pf-rose,
    /// @value(13)
    af-netbeui,
    /// @value(13)
    pf-netbeui,
    /// @value(14)
    af-security,
    /// @value(14)
    pf-security,
    /// @value(15)
    af-key,
    /// @value(15)
    pf-key,
    /// @value(16)
    af-netlink,
    /// @value(16)
    af-route,
    /// @value(16)
    pf-netlink,
    /// @value(16)
    pf-route,
    /// @value(17)
    af-packet,
    /// @value(17)
    pf-packet,
    /// @value(18)
    af-ash,
    /// @value(18)
    pf-ash,
    /// @value(19)
    af-econet,
    /// @value(19)
    pf-econet,
    /// @value(20)
    af-atmsvc,
    /// @value(20)
    pf-atmsvc,
    /// @value(21)
    af-rds,
    /// @value(21)
    pf-rds,
    /// @value(22)
    af-sna,
    /// @value(22)
    pf-sna,
    /// @value(23)
    af-irda,
    /// @value(23)
    pf-irda,
    /// @value(24)
    af-pppox,
    /// @value(24)
    pf-pppox,
    /// @value(25)
    af-wanpipe,
    /// @value(25)
    pf-wanpipe,
    /// @value(26)
    af-llc,
    /// @value(26)
    pf-llc,
    /// @value(27)
    af-ib,
    /// @value(27)
    pf-ib,
    /// @value(28)
    af-mpls,
    /// @value(28)
    pf-mpls,
    /// @value(29)
    af-can,
    /// @value(29)
    pf-can,
    /// @value(30)
    af-tipc,
    /// @value(30)
    pf-tipc,
    /// @value(31)
    af-bluetooth,
    /// @value(31)
    pf-bluetooth,
    /// @value(32)
    af-iucv,
    /// @value(32)
    pf-iucv,
    /// @value(33)
    af-rxrpc,
    /// @value(33)
    pf-rxrpc,
    /// @value(34)
    af-isdn,
    /// @value(34)
    pf-isdn,
    /// @value(35)
    af-phonet,
    /// @value(35)
    pf-phonet,
    /// @value(36)
    af-ieee802154,
    /// @value(36)
    pf-ieee802154,
    /// @value(37)
    af-caif,
    /// @value(37)
    pf-caif,
    /// @value(38)
    af-alg,
    /// @value(38)
    pf-alg,
    /// @value(39)
    af-nfc,
    /// @value(39)
    pf-nfc,
    /// @value(40)
    af-vsock,
    /// @value(40)
    pf-vsock,
    /// @value(41)
    af-kcm,
    /// @value(41)
    pf-kcm,
    /// @value(42)
    af-qipcrtr,
    /// @value(42)
    pf-qipcrtr,
