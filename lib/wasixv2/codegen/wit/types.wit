    /// @value(0x40)
    o-creat,
    /// @value(0x80)
    o-excl,
    /// @value(0x100)
    o-noctty,
    /// @value(0x200)
    o-trunc,
    /// @value(0x400)
    o-append,
    /// @value(0x800)
    o-ndelay,
    /// @value(0x800)
    o-nonblock,
    /// @value(0x1000)
    o-dsync,
    /// @value(0x4000)
    o-direct,
    /// @value(0x8000)
    o-largefile,
    /// @value(0x10000)
    o-directory,
    /// @value(0x20000)
    o-nofollow,
    /// @value(0x40000)
    o-noatime,
    /// @value(0x80000)
    o-cloexec,
    /// @name(__O_SYNC)
    /// @value(0x100000)
    o-sync-bit,
    /// @value(0x101000)
    o-sync,
    /// @value(0x200000)
    o-path,
    /// @name(__O_TMPFILE)
    /// @value(0x400000)
    o-tmpfile-bit,
    /// @value(0x410000)
    o-tmpfile,
    /// @value(0x4000000)
    o-emptypath,
  }

