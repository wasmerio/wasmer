  // ==== Futexes ====

  /// `futex_waitv`/`futex_requeue` waiter (`struct futex_waitv`).
  /// @kernel-only
  /// @size(24)
  /// @align(8)
  record futex-waitv {
    val: u64,
    /// Guest address of the futex word, zero-extended.
    uaddr: u64,
    %flags: futex2-flags,
    /// @c-name(__reserved)
    reserved: u32,
  }

  /// `futex_time64` operations and their modifier bits (`linux/futex.h`).
  /// The operation is `op & FUTEX_CMD_MASK`; `FUTEX_PRIVATE_FLAG` and `FUTEX_CLOCK_REALTIME` may be ORed in.
  /// @repr(s32)
  /// @c(int)
  enum futex-op {
    /// @value(0)
    futex-wait,
    /// @value(1)
    futex-wake,
    /// @value(2)
    futex-fd,
    /// @value(3)
    futex-requeue,
    /// @value(4)
    futex-cmp-requeue,
    /// @value(5)
    futex-wake-op,
    /// @value(6)
    futex-lock-pi,
    /// @value(7)
    futex-unlock-pi,
    /// @value(8)
    futex-trylock-pi,
    /// @value(9)
    futex-wait-bitset,
    /// @value(10)
    futex-wake-bitset,
    /// @value(11)
    futex-wait-requeue-pi,
    /// @value(12)
    futex-cmp-requeue-pi,
    /// @value(13)
    futex-lock-pi2,
    /// @value(128)
    futex-private-flag,
    /// @value(128)
    futex-wait-private,
    /// @value(129)
    futex-wake-private,
    /// @value(131)
    futex-requeue-private,
    /// @value(132)
    futex-cmp-requeue-private,
    /// @value(133)
    futex-wake-op-private,
    /// @value(134)
    futex-lock-pi-private,
    /// @value(135)
    futex-unlock-pi-private,
    /// @value(136)
    futex-trylock-pi-private,
    /// @value(137)
    futex-wait-bitset-private,
    /// @value(138)
    futex-wake-bitset-private,
    /// @value(139)
    futex-wait-requeue-pi-private,
    /// @value(140)
    futex-cmp-requeue-pi-private,
    /// @value(141)
    futex-lock-pi2-private,
    /// @value(256)
    futex-clock-realtime,
    /// @value(513)
    futex-unlock-wake-list64,
    /// @value(519)
    futex-unlock-pi-list64,
    /// @value(522)
    futex-unlock-bitset-list64,
    /// @value(641)
    futex-unlock-wake-list64-private,
    /// @value(647)
    futex-unlock-pi-list64-private,
    /// @value(650)
    futex-unlock-bitset-list64-private,
    /// @value(1537)
    futex-unlock-wake-list32,
    /// @value(1543)
    futex-unlock-pi-list32,
    /// @value(1546)
    futex-unlock-bitset-list32,
    /// @value(1665)
    futex-unlock-wake-list32-private,
    /// @value(1671)
    futex-unlock-pi-list32-private,
    /// @value(1674)
    futex-unlock-bitset-list32-private,
    /// @value(-1921)
    futex-cmd-mask,
  }

  /// `FUTEX_WAKE_OP` encoding of `val3` (`linux/futex.h`).
