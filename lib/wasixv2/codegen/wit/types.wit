  /// Indices into `termios.c_cc` (`asm-generic/termbits.h`).
  /// @repr(u32)
  enum termios-cc-index {
    /// @value(0)
    vintr,
    /// @value(1)
    vquit,
    /// @value(2)
    verase,
    /// @value(3)
    vkill,
    /// @value(4)
    veof,
    /// @value(5)
    vtime,
    /// @value(6)
    vmin,
    /// @value(7)
    vswtc,
    /// @value(8)
    vstart,
    /// @value(9)
    vstop,
    /// @value(10)
    vsusp,
    /// @value(11)
    veol,
    /// @value(12)
    vreprint,
    /// @value(13)
    vdiscard,
    /// @value(14)
    vwerase,
    /// @value(15)
    vlnext,
    /// @value(16)
    veol2,
  }

  /// Other termios constants. Kernel `NCCS` is 19; musl's user-level `NCCS` is 32.
  /// @repr(u32)
  enum termios-misc {
    /// @value(16)
    ibshift,
    /// @value(19)
    /// No C assert: musl's `NCCS` is 32, sizing its larger `struct termios` (`termios` is
    /// `@kernel-only`).
    /// @c-skip
    nccs,
  }

  /// `tcsetattr` actions (`TCSA*`).
  /// @repr(s32)
  enum tcsetattr-action {
    /// @value(0)
    tcsanow,
    /// @value(1)
    tcsadrain,
    /// @value(2)
    tcsaflush,
  }

  /// `TCFLSH` argument.
  /// @repr(s32)
  enum tcflush-queue {
    /// @value(0)
    tciflush,
    /// @value(1)
    tcoflush,
    /// @value(2)
    tcioflush,
  }

  /// `TCXONC` argument.
  /// @repr(s32)
  enum tcflow-action {
    /// @value(0)
    tcooff,
    /// @value(1)
    tcoon,
    /// @value(2)
    tcioff,
    /// @value(3)
    tcion,
  }

  /// Packet mode status byte (`TIOCPKT_*`).
  /// @repr(u32)
  flags tiocpkt-flags {
    /// @value(0x0)
    tiocpkt-data,
    /// @value(0x1)
    tiocpkt-flushread,
    /// @value(0x2)
    tiocpkt-flushwrite,
    /// @value(0x4)
    tiocpkt-stop,
    /// @value(0x8)
    tiocpkt-start,
    /// @value(0x10)
    tiocpkt-nostop,
    /// @value(0x20)
    tiocpkt-dostop,
    /// @value(0x40)
    tiocpkt-ioctl,
  }

  /// `TIOCSERGETLSR` result bits.
  /// @repr(u32)
  flags tiocser-flags {
    /// @value(0x1)
    tiocser-temt,
  }

  // ==== Mounting ====

  /// `mount_setattr`/`open_tree_attr` attributes (`struct mount_attr`).
  /// @kernel-only
  /// @size(32)
  /// @align(8)
  record mount-attr {
    attr-set: mount-attr-flags,
    attr-clr: mount-attr-flags,
    propagation: u64,
    userns-fd: u64,
  }

  /// `statmount`/`listmount` request (`struct mnt_id_req`). `mnt-ns-fd` is a union with `mnt_fd`.
  /// @kernel-only
  /// @size(32)
  /// @align(8)
  record mnt-id-req {
    size: u32,
    mnt-ns-fd: u32,
    mnt-id: u64,
    param: u64,
    mnt-ns-id: u64,
  }

  /// `listns` request (`struct ns_id_req`).
  /// @kernel-only
  /// @size(32)
  /// @align(8)
  record ns-id-req {
    size: u32,
    spare: u32,
    ns-id: u64,
    ns-type: u32,
    spare2: u32,
    user-ns-id: u64,
  }

  /// `mount` flags (`MS_*`, `linux/mount.h`).
  /// @repr(u32)
  /// @c(unsigned long)
  flags mount-flags {
    /// @value(0x1)
    ms-rdonly,
    /// @value(0x2)
    ms-nosuid,
    /// @value(0x4)
    ms-nodev,
    /// @value(0x8)
    ms-noexec,
    /// @value(0x10)
    ms-synchronous,
    /// @value(0x20)
    ms-remount,
    /// @value(0x40)
    ms-mandlock,
    /// @value(0x80)
    ms-dirsync,
    /// @value(0x100)
    ms-nosymfollow,
    /// @value(0x400)
    ms-noatime,
    /// @value(0x800)
    ms-nodiratime,
    /// @value(0x1000)
    ms-bind,
    /// @value(0x2000)
    ms-move,
    /// @value(0x4000)
    ms-rec,
    /// @value(0x8000)
    ms-silent,
    /// @value(0x8000)
    ms-verbose,
    /// @value(0x10000)
    ms-posixacl,
    /// @value(0x20000)
    ms-unbindable,
    /// @value(0x40000)
    ms-private,
    /// @value(0x80000)
    ms-slave,
    /// @value(0x100000)
    ms-shared,
    /// @value(0x200000)
    ms-relatime,
    /// @value(0x400000)
    ms-kernmount,
    /// @value(0x800000)
    ms-i-version,
    /// @value(0x1000000)
    ms-strictatime,
    /// @value(0x2000000)
    ms-lazytime,
    /// @value(0x2800051)
    ms-rmt-mask,
    /// @value(0x4000000)
    ms-submount,
    /// @value(0x8000000)
    ms-noremotelock,
    /// @value(0x10000000)
    ms-nosec,
    /// @value(0x20000000)
    ms-born,
    /// @value(0x40000000)
    ms-active,
    /// @value(0x80000000)
    ms-nouser,
    /// @value(0xc0ed0000)
    ms-mgc-val,
    /// @value(0xffff0000)
    ms-mgc-msk,
  }

  /// `umount2` flags (musl `sys/mount.h`; kernel `include/linux/fs.h`).
  /// @repr(u32)
  /// @c(int)
  flags umount-flags {
    /// @value(0x1)
    mnt-force,
    /// @value(0x2)
    mnt-detach,
    /// @value(0x4)
    mnt-expire,
    /// @value(0x8)
    umount-nofollow,
  }

  /// `MOUNT_ATTR_*` (`linux/mount.h`): `mount_attr.attr_set`/`attr_clr` and `fsmount` attr flags.
  /// @repr(u64)
  flags mount-attr-flags {
    /// @value(0x0)
    mount-attr-relatime,
    /// @value(0x1)
    mount-attr-rdonly,
    /// @value(0x2)
    mount-attr-nosuid,
    /// @value(0x4)
    mount-attr-nodev,
    /// @value(0x8)
    mount-attr-noexec,
    /// @value(0x10)
    mount-attr-noatime,
    /// @value(0x20)
    mount-attr-strictatime,
    /// @name(MOUNT_ATTR__ATIME)
    /// @value(0x70)
    mount-attr-atime,
    /// @value(0x80)
    mount-attr-nodiratime,
    /// @value(0x100000)
    mount-attr-idmap,
    /// @value(0x200000)
    mount-attr-nosymfollow,
  }

  /// `move_mount` flags (`linux/mount.h`).
  /// @repr(u32)
  /// @c(unsigned)
  flags move-mount-flags {
    /// @value(0x1)
    move-mount-f-symlinks,
