    xattr-create,
    /// @value(0x2)
    xattr-replace,
  }

  /// `inotify_init1` flags (`linux/inotify.h`).
  /// @repr(u32)
  /// @c(int)
  flags inotify-init-flags {
    /// @value(0x800)
    in-nonblock,
    /// @value(0x80000)
    in-cloexec,
  }

  /// `inotify_add_watch` mask and `inotify_event.mask` bits (`linux/inotify.h`).
  /// @repr(u32)
  /// @c(uint32_t)
  flags inotify-mask {
    /// @value(0x1)
    in-access,
    /// @value(0x2)
    in-modify,
    /// @value(0x4)
    in-attrib,
    /// @value(0x8)
    in-close-write,
    /// @value(0x10)
    in-close-nowrite,
    /// @value(0x18)
    in-close,
    /// @value(0x20)
    in-open,
    /// @value(0x40)
    in-moved-from,
    /// @value(0x80)
    in-moved-to,
    /// @value(0xc0)
    in-move,
    /// @value(0x100)
    in-create,
    /// @value(0x200)
    in-delete,
    /// @value(0x400)
    in-delete-self,
    /// @value(0x800)
    in-move-self,
    /// @value(0xfff)
    in-all-events,
    /// @value(0x2000)
    in-unmount,
    /// @value(0x4000)
    in-q-overflow,
    /// @value(0x8000)
    in-ignored,
    /// @value(0x1000000)
    in-onlydir,
    /// @value(0x2000000)
    in-dont-follow,
    /// @value(0x4000000)
    in-excl-unlink,
    /// @value(0x10000000)
    in-mask-create,
    /// @value(0x20000000)
    in-mask-add,
    /// @value(0x40000000)
    in-isdir,
    /// @value(0x80000000)
    in-oneshot,
  }

  /// Kernel limits (`linux/limits.h`, `linux/fs.h`, `linux/xattr.h`).
  /// @repr(u32)
  enum limits {
    /// @value(4)
    xattr-hurd-prefix-len,
    /// @value(4)
    xattr-mac-osx-prefix-len,
    /// @value(5)
    xattr-user-prefix-len,
    /// @value(6)
    xattr-btrfs-prefix-len,
    /// @value(7)
    xattr-system-prefix-len,
    /// @value(8)
    xattr-trusted-prefix-len,
    /// @value(9)
    xattr-security-prefix-len,
    /// @value(13)
    xattr-name-bpf-lsm-len,
    /// @value(32)
    rtsig-max,
    /// @value(127)
    link-max,
    /// @value(255)
    name-max,
    /// @value(255)
    xattr-name-max,
    /// @value(1024)
    inr-open-cur,
    /// @value(4096)
    inr-open-max,
    /// @value(4096)
    path-max,
    /// @value(0x10000)
    /// No C assert: musl's `<limits.h>` `NGROUPS_MAX` is 32, a libc limit below the kernel's 65536.
    /// @c-skip
    ngroups-max,
    /// @value(0x10000)
    xattr-list-max,
    /// @value(0x10000)
    xattr-size-max,
    /// @value(0x20000)
    arg-max,
  }

  // ==== Polling and event notification ====

  /// `ppoll_time64` entry (`struct pollfd`).
  /// @c(struct pollfd)
  /// @size(8)
  /// @align(4)
  record pollfd {
    fd: fd,
    events: poll-events,
    revents: poll-events,
  }

  /// User data of an epoll event (kernel: a plain `__u64`).
  /// @c(union epoll_data)
  /// @union
  /// @size(8)
  /// @align(8)
  record epoll-data {
    ptr: uptr,
    fd: fd,
    %u32: u32,
    %u64: u64,
  }

  /// epoll event (`struct epoll_event`). Not packed on asm-generic: 4 bytes of implicit padding
  /// follow `events`.
  /// @c(struct epoll_event)
  /// @size(16)
  /// @align(8)
  record epoll-event {
    events: epoll-events,
    data: epoll-data,
  }

  /// 1024-bit descriptor set for `pselect6_time64` (`__kernel_fd_set`).
  /// @c(fd_set)
  /// @size(128)
  /// @align(4)
  record kernel-fd-set {
    fds-bits: list<ulong, 32>,
  }

  /// `pollfd.events`/`revents` (`asm-generic/poll.h`). C type is `short`.
  /// @repr(u16)
  /// @c(short)
  flags poll-events {
    /// @value(0x1)
    pollin,
    /// @value(0x2)
    pollpri,
    /// @value(0x4)
    pollout,
    /// @value(0x8)
    pollerr,
    /// @value(0x10)
    pollhup,
    /// @value(0x20)
    pollnval,
    /// @value(0x40)
    pollrdnorm,
    /// @value(0x80)
    pollrdband,
    /// @value(0x100)
    pollwrnorm,
    /// @value(0x200)
    pollwrband,
    /// @value(0x400)
    pollmsg,
    /// @value(0x1000)
    pollremove,
    /// @value(0x2000)
    pollrdhup,
  }

  /// `epoll_event.events` (`linux/eventpoll.h`).
  /// @repr(u32)
  /// @c(uint32_t)
  flags epoll-events {
    /// From `linux/eventpoll.h` (not in the extracted constant set).
    /// @value(0x1)
    epollin,
    /// From `linux/eventpoll.h` (not in the extracted constant set).
    /// @value(0x2)
    epollpri,
    /// From `linux/eventpoll.h` (not in the extracted constant set).
    /// @value(0x4)
    epollout,
    /// From `linux/eventpoll.h` (not in the extracted constant set).
    /// @value(0x8)
    epollerr,
    /// From `linux/eventpoll.h` (not in the extracted constant set).
    /// @value(0x10)
    epollhup,
    /// From `linux/eventpoll.h` (not in the extracted constant set).
    /// @value(0x20)
    epollnval,
    /// From `linux/eventpoll.h` (not in the extracted constant set).
    /// @value(0x40)
    epollrdnorm,
    /// From `linux/eventpoll.h` (not in the extracted constant set).
    /// @value(0x80)
    epollrdband,
    /// From `linux/eventpoll.h` (not in the extracted constant set).
    /// @value(0x100)
    epollwrnorm,
    /// From `linux/eventpoll.h` (not in the extracted constant set).
    /// @value(0x200)
    epollwrband,
    /// From `linux/eventpoll.h` (not in the extracted constant set).
    /// @value(0x400)
    epollmsg,
    /// From `linux/eventpoll.h` (not in the extracted constant set).
    /// @value(0x2000)
    epollrdhup,
    /// From `linux/eventpoll.h` (not in the extracted constant set).
    /// @value(0x8000000)
    epoll-uring-wake,
    /// From `linux/eventpoll.h` (not in the extracted constant set).
    /// @value(0x10000000)
    epollexclusive,
    /// From `linux/eventpoll.h` (not in the extracted constant set).
    /// @value(0x20000000)
    epollwakeup,
    /// From `linux/eventpoll.h` (not in the extracted constant set).
    /// @value(0x40000000)
    epolloneshot,
    /// From `linux/eventpoll.h` (not in the extracted constant set).
    /// @value(0x80000000)
    epollet,
  }

  /// `epoll_create1` flags (`linux/eventpoll.h`).
  /// @repr(u32)
  /// @c(int)
  flags epoll-create-flags {
    /// @value(0x80000)
    epoll-cloexec,
  }

  /// `epoll_ctl` operations (`linux/eventpoll.h`).
  /// @repr(s32)
  /// @c(int)
  enum epoll-ctl-op {
    /// @value(1)
    epoll-ctl-add,
    /// @value(2)
    epoll-ctl-del,
    /// @value(3)
    epoll-ctl-mod,
  }

  /// `eventfd2` flags (`linux/eventfd.h`).
  /// @repr(u32)
  /// @c(int)
  flags eventfd-flags {
    /// @value(0x1)
    efd-semaphore,
    /// @value(0x800)
    efd-nonblock,
    /// @value(0x80000)
    efd-cloexec,
  }

  /// `signalfd4` flags (`linux/signalfd.h`).
  /// @repr(u32)
  /// @c(int)
  flags signalfd-flags {
    /// @value(0x800)
    sfd-nonblock,
    /// @value(0x80000)
    sfd-cloexec,
  }

  // ==== Signals ====

  /// Kernel signal set (`sigset_t` in `asm-generic/signal.h`): 64 signals, 8 bytes.
  /// Every `sigsetsize` argument must be 8. musl's 128-byte user `sigset_t` starts with the same words.
  /// @kernel-only
  /// @size(8)
  /// @align(4)
  record sigset {
    sig: list<ulong, 2>,
  }

  /// Kernel signal action for `rt_sigaction` (asm-generic `struct sigaction`, 16 bytes).
  /// riscv has no `SA_RESTORER`, so there is no `sa_restorer` field. musl passes its internal
  /// `struct k_sigaction` (`src/internal/ksigaction.h`); upstream musl riscv32 wrongly adds a
  /// restorer field (20 bytes), which the wasixv2 port must not do.
  /// @c(struct k_sigaction)
  /// @size(16)
  /// @align(4)
  record sigaction {
    /// Handler address, or a `signal-handler` value.
    /// @c-name(handler)
    sa-handler: uptr,
    /// `sa-flags` bits.
    /// @c-name(flags)
    sa-flags: ulong,
    /// @c-name(mask)
    sa-mask: sigset,
  }

  /// Alternate signal stack (`stack_t`, `struct sigaltstack`).
  /// @c(stack_t)
  /// @size(12)
  /// @align(4)
  record sigaltstack {
    ss-sp: uptr,
    /// `sigaltstack-flags` bits.
    ss-flags: s32,
    ss-size: usize,
  }

  /// Signal value (`union sigval`).
  /// @c(union sigval)
  /// @union
  /// @size(4)
  /// @align(4)
  record sigval {
    sival-int: s32,
    sival-ptr: uptr,
  }

  /// Signal information (`siginfo_t`, 128 bytes). Only the common header is modelled; `sifields`
  /// is the `union __sifields` padded to 116 bytes. Offsets of the common union members:
  ///
  /// - kill/rt: `si_pid` 12, `si_uid` 16, `si_value` 20
  /// - timer: `si_tid` 12, `si_overrun` 16, `si_value` 20
  /// - SIGCHLD: `si_pid` 12, `si_uid` 16, `si_status` 20, `si_utime` 24, `si_stime` 28 (32-bit clock_t)
  /// - SIGILL/SIGFPE/SIGSEGV/SIGBUS: `si_addr` 12
  /// - SIGPOLL: `si_band` 12 (long), `si_fd` 16
  /// - SIGSYS: `si_call_addr` 12, `si_syscall` 16, `si_arch` 20
  /// @c(siginfo_t)
  /// @size(128)
  /// @align(4)
  record siginfo {
    si-signo: s32,
    si-errno: s32,
    /// `si-code` value.
    si-code: s32,
    /// musl: `__si_fields`.
    /// @c-name(__si_fields)
    sifields: list<u8, 116>,
  }

  /// `SIGEV_THREAD` member of `sigevent-un` (anonymous struct `_sigev_thread`).
  /// @kernel-only
  /// @size(8)
  /// @align(4)
  record sigevent-thread {
    /// @c-name(_function)
    function: uptr,
    /// @c-name(_attribute)
    attribute: uptr,
  }

  /// The `_sigev_un` union of `sigevent`.
  /// @kernel-only
  /// @union
  /// @size(52)
  /// @align(4)
  record sigevent-un {
    /// @c-name(_pad)
    pad: list<s32, 13>,
    /// Thread id for `SIGEV_THREAD_ID`.
    /// @c-name(_tid)
    tid: pid,
    /// @c-name(_sigev_thread)
    sigev-thread: sigevent-thread,
  }

  /// Notification request for `timer_create` and `mq_notify` (`struct sigevent`, 64 bytes).
  /// @c(struct sigevent)
  /// @size(64)
  /// @align(4)
  record sigevent {
    sigev-value: sigval,
    sigev-signo: s32,
    /// `sigev-notify` value.
    sigev-notify: s32,
    /// musl: `__sev_fields`.
    /// @c-name(__sev_fields)
    sigev-un: sigevent-un,
  }

  /// Record read from a signalfd (`struct signalfd_siginfo`).
  /// @c(struct signalfd_siginfo)
  /// @size(128)
  /// @align(8)
  record signalfd-siginfo {
    ssi-signo: u32,
    ssi-errno: s32,
    ssi-code: s32,
    ssi-pid: u32,
    ssi-uid: u32,
    ssi-fd: s32,
    ssi-tid: u32,
    ssi-band: u32,
    ssi-overrun: u32,
    ssi-trapno: u32,
    ssi-status: s32,
    ssi-int: s32,
    ssi-ptr: u64,
    ssi-utime: u64,
    ssi-stime: u64,
    ssi-addr: u64,
    ssi-addr-lsb: u16,
    /// @c-name(__pad2)
    pad2: u16,
    ssi-syscall: s32,
    ssi-call-addr: u64,
    ssi-arch: u32,
    /// @c-name(__pad)
    pad: list<u8, 28>,
  }

  /// 6th argument of `pselect6_time64` (`struct sigset_argpack` in fs/select.c).
  /// @kernel-only
  /// @size(8)
  /// @align(4)
  record sigset-argpack {
    p: const-sigset-ptr,
    size: usize,
  }

  /// Signal numbers (`asm-generic/signal.h`).
  /// musl reserves 32..34 internally, so its `SIGRTMIN` is 35; the kernel value is 32.
  /// @repr(s32)
  /// @c(int)
  enum signal {
    /// @value(1)
    sighup,
    /// @value(2)
    sigint,
    /// @value(3)
    sigquit,
    /// @value(4)
    sigill,
    /// @value(5)
    sigtrap,
    /// @value(6)
    sigabrt,
    /// @value(6)
    sigiot,
    /// @value(7)
    sigbus,
    /// @value(8)
    sigfpe,
    /// @value(9)
    sigkill,
    /// @value(10)
    sigusr1,
    /// @value(11)
    sigsegv,
    /// @value(12)
    sigusr2,
    /// @value(13)
    sigpipe,
    /// @value(14)
    sigalrm,
    /// @value(15)
    sigterm,
    /// @value(16)
    sigstkflt,
    /// @value(17)
    sigchld,
    /// @value(18)
    sigcont,
    /// @value(19)
    sigstop,
    /// @value(20)
    sigtstp,
    /// @value(21)
    sigttin,
    /// @value(22)
    sigttou,
    /// @value(23)
    sigurg,
    /// @value(24)
    sigxcpu,
    /// @value(25)
    sigxfsz,
    /// @value(26)
    sigvtalrm,
    /// @value(27)
    sigprof,
    /// @value(28)
    sigwinch,
    /// @value(29)
    sigio,
    /// @value(29)
    sigpoll,
    /// @value(30)
    sigpwr,
    /// @value(31)
    sigsys,
    /// @value(31)
    sigunused,
    /// @value(32)
    /// No C assert: musl's `SIGRTMIN` is a function call (`__libc_current_sigrtmin()`), not a constant.
    /// @c-skip
    sigrtmin,
    /// @value(64)
    /// No C assert: musl's `SIGRTMAX` is a function call (`__libc_current_sigrtmax()`), not a constant.
    /// @c-skip
    sigrtmax,
  }

  /// Signal-related sizes (`asm-generic/signal.h`, `asm-generic/siginfo.h`).
  /// @repr(u32)
  enum signal-limits {
    /// @name(_NSIG_WORDS)
    /// @value(2)
    nsig-words,
    /// @value(13)
    sigev-pad-size,
    /// @name(_NSIG_BPW)
    /// @value(32)
    nsig-bpw,
    /// @value(64)
    sigev-max-size,
    /// @name(_NSIG)
    /// @value(64)
    /// No C assert: musl's `_NSIG` is 65 (signals 1..64 plus one), the kernel's is 64.
    /// @c-skip
    nsig,
    /// @value(2048)
    minsigstksz,
    /// @value(8192)
    sigstksz,
  }

  /// `sigaction.sa_flags` (`asm-generic/signal-defs.h`).
  /// riscv (and therefore wasixv2) has no `SA_RESTORER`.
  /// @repr(u32)
  /// @c(unsigned long)
  flags sa-flags {
    /// @value(0x1)
    sa-nocldstop,
    /// @value(0x2)
    sa-nocldwait,
    /// @value(0x4)
    sa-siginfo,
    /// @value(0x400)
    sa-unsupported,
    /// @value(0x800)
    sa-expose-tagbits,
    /// @value(0x8000000)
    sa-onstack,
    /// @value(0x10000000)
    sa-restart,
    /// @value(0x40000000)
    sa-nodefer,
    /// @value(0x40000000)
    sa-nomask,
    /// @value(0x80000000)
    sa-oneshot,
    /// @value(0x80000000)
    sa-resethand,
  }

  /// Special `sa_handler` values (`asm-generic/signal-defs.h`).
  /// @repr(s32)
  enum signal-handler {
    /// From `asm-generic/signal-defs.h` (not in the extracted constant set).
    /// @value(0)
    sig-dfl,
    /// From `asm-generic/signal-defs.h` (not in the extracted constant set).
    /// @value(1)
    sig-ign,
    /// From `asm-generic/signal-defs.h` (not in the extracted constant set).
    /// @value(-1)
    sig-err,
  }

  /// `how` for `rt_sigprocmask` (`asm-generic/signal-defs.h`).
  /// @repr(s32)
  /// @c(int)
  enum sigprocmask-how {
    /// From `asm-generic/signal-defs.h` (not in the extracted constant set).
    /// @value(0)
    sig-block,
    /// From `asm-generic/signal-defs.h` (not in the extracted constant set).
    /// @value(1)
    sig-unblock,
    /// From `asm-generic/signal-defs.h` (not in the extracted constant set).
    /// @value(2)
    sig-setmask,
  }

  /// `stack_t.ss_flags` (`linux/signal.h`).
  /// @repr(u32)
  /// @c(int)
  flags sigaltstack-flags {
    /// From `linux/signal.h` (not in the extracted constant set).
    /// @value(0x1)
    ss-onstack,
    /// From `linux/signal.h` (not in the extracted constant set).
    /// @value(0x2)
    ss-disable,
    /// From `linux/signal.h` (not in the extracted constant set).
    /// @value(0x80000000)
    ss-autodisarm,
  }

  /// `siginfo.si_code` values (`asm-generic/siginfo.h`).
  /// The meaning of positive values depends on the signal number.
  /// @repr(s32)
  /// @c(int)
  enum si-code {
    /// @value(0)
    si-user,
    /// @value(1)
    bus-adraln,
    /// @value(1)
    cld-exited,
    /// @value(1)
    fpe-intdiv,
    /// @value(1)
    ill-illopc,
    /// @value(1)
    poll-in,
    /// @value(1)
    segv-maperr,
    /// @value(1)
    sys-seccomp,
    /// @value(1)
    trap-brkpt,
    /// @value(2)
    bus-adrerr,
    /// @value(2)
    cld-killed,
    /// @value(2)
    fpe-intovf,
    /// @value(2)
    ill-illopn,
    /// @value(2)
    poll-out,
    /// @value(2)
    segv-accerr,
    /// @value(2)
    sys-user-dispatch,
    /// @value(2)
    trap-trace,
    /// @value(3)
    bus-objerr,
    /// @value(3)
    cld-dumped,
    /// @value(3)
    fpe-fltdiv,
    /// @value(3)
    ill-illadr,
    /// @value(3)
    poll-msg,
    /// @value(3)
    segv-bnderr,
    /// @value(3)
    trap-branch,
    /// @value(4)
    bus-mceerr-ar,
    /// @value(4)
    cld-trapped,
    /// @value(4)
    fpe-fltovf,
    /// @value(4)
    ill-illtrp,
    /// @value(4)
    poll-err,
    /// @value(4)
    segv-pkuerr,
    /// @value(4)
    trap-hwbkpt,
    /// @value(5)
    bus-mceerr-ao,
    /// @value(5)
    cld-stopped,
    /// @value(5)
    fpe-fltund,
    /// @value(5)
    ill-prvopc,
    /// @value(5)
    poll-pri,
    /// @value(5)
    segv-accadi,
    /// @value(5)
    trap-unk,
    /// @value(6)
    cld-continued,
    /// @value(6)
    fpe-fltres,
    /// @value(6)
    ill-prvreg,
    /// @value(6)
    poll-hup,
    /// @value(6)
    segv-adiderr,
    /// @value(6)
    trap-perf,
    /// @value(7)
    fpe-fltinv,
    /// @value(7)
    ill-coproc,
    /// @value(7)
    segv-adiperr,
    /// @value(8)
    fpe-fltsub,
    /// @value(8)
    ill-badstk,
    /// @value(8)
    segv-mteaerr,
    /// @value(9)
    ill-badiaddr,
    /// @value(9)
    segv-mteserr,
    /// @value(10)
    segv-cperr,
    /// @value(14)
    fpe-fltunk,
    /// @value(15)
    fpe-condtrap,
    /// @value(128)
    si-kernel,
    /// @value(-60)
    si-asyncnl,
    /// @value(-7)
    si-dethread,
    /// @value(-6)
    si-tkill,
    /// @value(-5)
    si-sigio,
    /// @value(-4)
