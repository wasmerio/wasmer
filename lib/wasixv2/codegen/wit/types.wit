    /// @c-skip
    f-setlkw,
    /// @value(8)
    f-setown,
    /// @value(9)
    f-getown,
    /// @value(10)
    f-setsig,
    /// @value(11)
    f-getsig,
    /// @value(12)
    f-getlk64,
    /// @value(13)
    f-setlk64,
    /// @value(14)
    f-setlkw64,
    /// @value(15)
    f-setown-ex,
    /// @value(16)
    f-getown-ex,
    /// @value(17)
    f-getowner-uids,
    /// @value(36)
    f-ofd-getlk,
    /// @value(37)
    f-ofd-setlk,
    /// @value(38)
    f-ofd-setlkw,
    /// @value(1024)
    f-linux-specific-base,
    /// @value(1024)
    f-setlease,
    /// @value(1025)
    f-getlease,
    /// @value(1026)
    f-notify,
    /// @value(1027)
    f-dupfd-query,
    /// @value(1028)
    f-created-query,
    /// @value(1029)
    f-cancellk,
    /// @value(1030)
    f-dupfd-cloexec,
    /// @value(1031)
    f-setpipe-sz,
    /// @value(1032)
    f-getpipe-sz,
    /// @value(1033)
    f-add-seals,
    /// @value(1034)
    f-get-seals,
    /// @value(1035)
