  /// `sigevent.sigev_notify` (`asm-generic/siginfo.h`).
  /// @repr(s32)
  /// @c(int)
  enum sigev-notify {
    /// @value(0)
    sigev-signal,
    /// @value(1)
    sigev-none,
    /// @value(2)
    sigev-thread,
    /// @value(4)
    sigev-thread-id,
