    move-mount-f-automounts,
    /// @value(0x4)
    move-mount-f-empty-path,
    /// @value(0x10)
    move-mount-t-symlinks,
    /// @value(0x20)
    move-mount-t-automounts,
    /// @value(0x40)
    move-mount-t-empty-path,
    /// @value(0x100)
    move-mount-set-group,
    /// @value(0x200)
    move-mount-beneath,
    /// @name(MOVE_MOUNT__MASK)
    /// @value(0x377)
    move-mount-mask,
  }

  /// `open_tree` flags (`linux/mount.h`); `AT_*` flags may be ORed in.
  /// @repr(u32)
  /// @c(unsigned)
  flags open-tree-flags {
    /// @value(0x1)
    open-tree-clone,
    /// @value(0x2)
    open-tree-namespace,
  }

  /// `fsopen` flags (`linux/mount.h`).
  /// @repr(u32)
  /// @c(unsigned)
  flags fsopen-flags {
    /// @value(0x1)
    fsopen-cloexec,
  }

  /// `fsmount` flags (`linux/mount.h`).
  /// @repr(u32)
  /// @c(unsigned)
  flags fsmount-flags {
    /// @value(0x1)
    fsmount-cloexec,
    /// @value(0x2)
    fsmount-namespace,
  }

  /// `fspick` flags (`linux/mount.h`).
  /// @repr(u32)
  /// @c(unsigned)
  flags fspick-flags {
    /// @value(0x1)
    fspick-cloexec,
    /// @value(0x2)
    fspick-symlink-nofollow,
    /// @value(0x4)
    fspick-no-automount,
    /// @value(0x8)
    fspick-empty-path,
  }
}
