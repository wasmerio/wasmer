  /// `fcntl64` commands (`asm-generic/fcntl.h`, `linux/fcntl.h`).
  /// Kernel spelling: `F_GETLK`/`F_SETLK`/`F_SETLKW` (5/6/7) take the legacy 16-byte `struct flock`; musl on
  /// riscv32 defines `F_GETLK` as 12 (= `F_GETLK64`) and only ever passes `flock64`.
  /// @repr(s32)
  /// @c(int)
  enum fcntl-cmd {
    /// @value(0)
    f-dupfd,
    /// @value(1)
    f-getfd,
    /// @value(2)
    f-setfd,
    /// @value(3)
    f-getfl,
    /// @value(4)
    f-setfl,
    /// @value(5)
