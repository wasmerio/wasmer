  // ==== Processes, scheduling and resources ====

  /// Resource usage with legacy 32-bit `timeval`s (kernel `struct rusage`, 72 bytes).
  /// musl's 152-byte `struct rusage` is different: it lets the kernel fill the start and converts.
  /// @kernel-only
  /// @size(72)
  /// @align(4)
  record rusage {
    ru-utime: kernel-old-timeval,
    ru-stime: kernel-old-timeval,
    ru-maxrss: slong,
    ru-ixrss: slong,
    ru-idrss: slong,
    ru-isrss: slong,
    ru-minflt: slong,
    ru-majflt: slong,
    ru-nswap: slong,
    ru-inblock: slong,
    ru-oublock: slong,
    ru-msgsnd: slong,
    ru-msgrcv: slong,
    ru-nsignals: slong,
    ru-nvcsw: slong,
    ru-nivcsw: slong,
  }

  /// Resource limit for `prlimit64` (`struct rlimit64`). See `rlim-value` for infinity.
  /// @c(struct rlimit)
  /// @size(16)
  /// @align(8)
  record rlimit64 {
    rlim-cur: u64,
    rlim-max: u64,
  }

  /// System statistics (kernel `struct sysinfo`, 64 bytes).
  /// musl's 312-byte `struct sysinfo` is a prefix-compatible superset.
  /// @kernel-only
  /// @size(64)
  /// @align(4)
  record sysinfo {
    uptime: slong,
    loads: list<ulong, 3>,
    totalram: ulong,
    freeram: ulong,
    sharedram: ulong,
    bufferram: ulong,
    totalswap: ulong,
    freeswap: ulong,
    procs: u16,
    pad: u16,
    totalhigh: ulong,
    freehigh: ulong,
    mem-unit: u32,
    /// @c-name(_f)
    f: list<u8, 8>,
  }

  /// `uname` result (`struct new_utsname`), six NUL-terminated 65-byte strings.
  /// musl names the last field `__domainname` unless `_GNU_SOURCE` is defined.
  /// @c(struct utsname)
  /// @size(390)
  /// @align(1)
  record new-utsname {
    sysname: list<u8, 65>,
    nodename: list<u8, 65>,
    release: list<u8, 65>,
    version: list<u8, 65>,
    machine: list<u8, 65>,
    domainname: list<u8, 65>,
  }

  /// Kernel `struct sched_param` (4 bytes). musl's 48-byte struct is a prefix-compatible superset.
  /// @kernel-only
  /// @size(4)
  /// @align(4)
  record sched-param {
    sched-priority: s32,
  }

  /// `sched_setattr`/`sched_getattr` attributes (`struct sched_attr`, size-versioned; VER1 = 56).
  /// @kernel-only
  /// @size(56)
  /// @align(8)
  record sched-attr {
    size: u32,
    sched-policy: u32,
    sched-flags: sched-flags,
    sched-nice: s32,
    sched-priority: u32,
    sched-runtime: u64,
    sched-deadline: u64,
    sched-period: u64,
    sched-util-min: u32,
    sched-util-max: u32,
  }

  /// `clone3` arguments (`struct clone_args`, size-versioned; VER2 = 88).
  /// Pointer fields hold zero-extended guest addresses.
  /// @kernel-only
  /// @size(88)
  /// @align(8)
  record clone-args {
    %flags: clone-flags,
    pidfd: u64,
    child-tid: u64,
    parent-tid: u64,
    exit-signal: u64,
    stack: u64,
    stack-size: u64,
    tls: u64,
    set-tid: u64,
    set-tid-size: u64,
    cgroup: u64,
  }

  /// `capget`/`capset` header (`struct __user_cap_header_struct`).
  /// @kernel-only
  /// @size(8)
  /// @align(4)
  record user-cap-header-struct {
    version: u32,
    pid: pid,
  }

  /// `capget`/`capset` data (`struct __user_cap_data_struct`); version 3 uses two of them.
  /// @kernel-only
  /// @size(12)
  /// @align(4)
  record user-cap-data-struct {
    effective: u32,
    permitted: u32,
    inheritable: u32,
  }

  /// Robust futex list entry (`struct robust_list`).
  /// @kernel-only
  /// @size(4)
  /// @align(4)
  record robust-list {
    next: uptr,
  }

  /// Robust futex list head (`struct robust_list_head`); `set_robust_list` requires len 12.
  /// @kernel-only
  /// @size(12)
  /// @align(4)
  record robust-list-head {
    %list: robust-list,
    futex-offset: slong,
    list-op-pending: uptr,
  }

  /// `kexec_load` segment (`struct kexec_segment`).
  /// @kernel-only
  /// @size(16)
  /// @align(4)
  record kexec-segment {
    buf: uptr,
    bufsz: usize,
    mem: uptr,
    memsz: usize,
  }

  /// `CLONE_*` flags (`linux/sched.h`): `clone` takes the low 32 bits, `clone3` all 64.
  /// `CSIGNAL` masks the exit signal in the low byte of `clone` flags.
  /// @repr(u64)
  /// @c(uint64_t)
  flags clone-flags {
    /// @value(0x80)
    clone-newtime,
    /// @value(0xff)
    csignal,
    /// @value(0x100)
    clone-vm,
    /// @value(0x200)
    clone-fs,
    /// @value(0x400)
    clone-files,
    /// @value(0x800)
    clone-sighand,
    /// @value(0x1000)
    clone-pidfd,
    /// @value(0x2000)
    clone-ptrace,
    /// @value(0x4000)
    clone-vfork,
    /// @value(0x8000)
    clone-parent,
    /// @value(0x10000)
    clone-thread,
    /// @value(0x20000)
    clone-newns,
    /// @value(0x40000)
    clone-sysvsem,
    /// @value(0x80000)
    clone-settls,
    /// @value(0x100000)
    clone-parent-settid,
    /// @value(0x200000)
    clone-child-cleartid,
    /// @value(0x400000)
    clone-detached,
    /// @value(0x800000)
    clone-untraced,
    /// @value(0x1000000)
    clone-child-settid,
    /// @value(0x2000000)
    clone-newcgroup,
    /// @value(0x4000000)
    clone-newuts,
    /// @value(0x8000000)
    clone-newipc,
    /// @value(0x10000000)
    clone-newuser,
    /// @value(0x20000000)
    clone-newpid,
    /// @value(0x40000000)
    clone-newnet,
    /// @value(0x80000000)
    clone-io,
    /// @value(0x100000000)
    clone-clear-sighand,
    /// @value(0x200000000)
    clone-into-cgroup,
    /// @value(0x400000000)
    clone-autoreap,
    /// @value(0x800000000)
    clone-nnp,
    /// @value(0x1000000000)
    clone-pidfd-autokill,
    /// @value(0x2000000000)
    clone-empty-mntns,
  }

  /// Known `struct clone_args` sizes (`linux/sched.h`).
  /// @repr(u32)
  enum clone-args-size {
    /// @value(64)
    clone-args-size-ver0,
    /// @value(80)
    clone-args-size-ver1,
    /// @value(88)
    clone-args-size-ver2,
  }

  /// Scheduling policies (`linux/sched.h`). `SCHED_RESET_ON_FORK` may be ORed into the policy.
  /// @repr(s32)
  /// @c(int)
  enum sched-policy {
    /// @value(0)
    sched-normal,
    /// @value(1)
    sched-fifo,
    /// @value(2)
    sched-rr,
    /// @value(3)
    sched-batch,
    /// @value(5)
    sched-idle,
    /// @value(6)
    sched-deadline,
    /// @value(7)
    sched-ext,
    /// @value(0x40000000)
    sched-reset-on-fork,
  }

  /// `sched_attr.sched_flags` (`linux/sched.h`).
  /// @repr(u64)
  /// @c(uint64_t)
  flags sched-flags {
    /// @value(0x1)
    sched-flag-reset-on-fork,
    /// @value(0x2)
    sched-flag-reclaim,
    /// @value(0x4)
    sched-flag-dl-overrun,
    /// @value(0x8)
    sched-flag-keep-policy,
    /// @value(0x10)
    sched-flag-keep-params,
    /// @value(0x18)
    sched-flag-keep-all,
    /// @value(0x20)
    sched-flag-util-clamp-min,
    /// @value(0x40)
    sched-flag-util-clamp-max,
    /// @value(0x60)
    sched-flag-util-clamp,
    /// @value(0x7f)
    sched-flag-all,
  }

  /// `sched_getattr` flags (`linux/sched.h`).
  /// @repr(u32)
  /// @c(unsigned)
  flags sched-getattr-flags {
    /// @value(0x1)
    sched-getattr-flag-dl-dynamic,
  }

  /// `waitid` id types (`linux/wait.h`). musl declares them as `idtype_t` enumerators.
  /// @repr(s32)
