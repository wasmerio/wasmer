  // ==== Polling and event notification ====

  /// Kernel: `sys_epoll_create1(int flags)`.
  /// No epoll_create on asm-generic.
  /// @nr(20)
  epoll-create1: func(%flags: epoll-create-flags) -> slong;

  /// Kernel: `sys_epoll_ctl(int epfd, int op, int fd, struct epoll_event * event)`.
  /// struct epoll_event is NOT packed on asm-generic (packed only on x86_64): 16 bytes, data at offset 8.
  /// @nr(21)
  epoll-ctl: func(epfd: fd, op: epoll-ctl-op, fd: fd, event: const-epoll-event-ptr) -> slong;

  /// Kernel: `sys_epoll_pwait(int epfd, struct epoll_event * events, int maxevents, int timeout, const
  /// sigset_t * sigmask, size_t sigsetsize)`.
  /// timeout is int ms; sigmask optional, sigsetsize must be 8. No epoll_wait on asm-generic: musl
  /// implements epoll_wait via epoll_pwait(..., NULL, 8).
  /// @nr(22)
  epoll-pwait: func(
    epfd: fd,
    events: epoll-event-array,
    maxevents: s32,
    timeout: s32,
    sigmask: const-sigset-ptr,
    sigsetsize: usize,
  ) -> slong;

  /// Kernel: `sys_epoll_pwait2(int epfd, struct epoll_event * events, int maxevents, const struct
  /// __kernel_timespec * timeout, const sigset_t * sigmask, size_t sigsetsize)`.
  /// timespec64 timeout.
  /// @nr(441)
  epoll-pwait2: func(
    epfd: fd,
    events: epoll-event-array,
    maxevents: s32,
    timeout: const-kernel-timespec-ptr,
    sigmask: const-sigset-ptr,
    sigsetsize: usize,
  ) -> slong;

  /// Kernel: `sys_ppoll(struct pollfd * ufds, unsigned int nfds, struct __kernel_timespec * tsp, const
  /// sigset_t * sigmask, size_t sigsetsize)`.
  /// No poll on riscv32: musl poll() -> ppoll_time64(fds, n, ts or NULL, NULL, 8). Kernel updates *tsp.
  /// @nr(414)
  ppoll-time64: func(
    ufds: pollfd-array,
    nfds: u32,
    tsp: kernel-timespec-ptr,
    sigmask: const-sigset-ptr,
    sigsetsize: usize,
  ) -> slong;

  /// Kernel: `sys_pselect6(int n, fd_set * inp, fd_set * outp, fd_set * exp, struct __kernel_timespec *
  /// tsp, void * sig)`.
  /// Kernel modifies *tsp (remaining time). 6th arg is pointer to {const sigset_t *ss; size_t ss_len} (8
  /// bytes on ILP32), NOT a sigset pointer. fd_set = 1024 bits = 128 bytes, unsigned long words (32-bit).
  /// No select on riscv32: musl select() -> pselect6_time64.
  /// @nr(413)
  pselect6-time64: func(
    n: s32,
    inp: kernel-fd-set-ptr,
    outp: kernel-fd-set-ptr,
    exp: kernel-fd-set-ptr,
    tsp: kernel-timespec-ptr,
    sig: const-sigset-argpack-ptr,
  ) -> slong;

  /// Kernel: `sys_eventfd2(unsigned int count, int flags)`.
  /// No eventfd.
  /// @nr(19)
  eventfd2: func(count: u32, %flags: eventfd-flags) -> slong;

  /// Kernel: `sys_signalfd4(int ufd, sigset_t * user_mask, size_t sizemask, int flags)`.
  /// sizemask must be 8 (kernel sigset_t size).
  /// @nr(74)
  signalfd4: func(ufd: fd, user-mask: const-sigset-ptr, sizemask: usize, %flags: signalfd-flags) -> slong;

  /// Kernel: `sys_timerfd_create(int clockid, int flags)`.
  /// @nr(85)
  timerfd-create: func(clockid: clock-id, %flags: timerfd-flags) -> slong;

  /// Kernel: `sys_timerfd_settime(int ufd, int flags, const struct __kernel_itimerspec * utmr, struct
  /// __kernel_itimerspec * otmr)`.
  /// @nr(411)
