/// Linux syscalls, one function per riscv32 syscall table entry.
///
/// Import name = riscv32 table name; return value = Linux `long` (value or `-errno`).
/// Arguments that riscv32 splits into register pairs are a single 64-bit parameter here.
/// `lookup_dcookie` (18) and `nfsservctl` (42) are omitted: they are `sys_ni_syscall` stubs.
/// @module(wasix2)
interface syscalls {
  use types.{
    access-mode, address-family, aio-context, aio-context-ptr, at-flags, buf, cachestat-ptr,
    clock-id, close-range-flags, const-aio-sigset-ptr, const-buf, const-cachestat-range-ptr,
    const-clone-args-ptr, const-epoll-event-ptr, const-file-attr-ptr, const-file-handle-ptr,
    const-futex-waitv-array, const-gid-array, const-iocb-ptr-array, const-iovec-array,
    const-kernel-itimerspec-ptr, const-kernel-old-itimerval-ptr, const-kernel-timespec-array,
    const-kernel-timespec-ptr, const-kexec-segment-array, const-landlock-ruleset-attr-ptr,
    const-lsm-ctx-ptr, const-mnt-id-req-ptr, const-mount-attr-ptr, const-mq-attr-ptr,
    const-msgbuf-ptr, const-ns-id-req-ptr, const-open-how-ptr, const-rlimit64-ptr, const-s32-array,
    const-sched-param-ptr, const-sembuf-array, const-sigaction-ptr, const-sigaltstack-ptr,
    const-sigevent-ptr, const-siginfo-ptr, const-sigset-argpack-ptr, const-sigset-ptr,
    const-sockaddr-ptr, const-ulong-array, const-uptr-array, const-user-cap-data-array,
    const-user-msghdr-ptr, const-void-ptr, const-xattr-args-ptr, cstr, cstr-array,
    epoll-create-flags, epoll-ctl-op, epoll-event-array, eventfd-flags, fadvise-advice,
    falloc-flags, fcntl-cmd, fd, fd-pair, file-attr-ptr, file-handle-ptr, flock-op, futex-op,
    futex2-flags, gid, gid-array, gid-ptr, grnd-flags, idtype, inotify-init-flags, inotify-mask,
    io-event-array, io-event-ptr, io-uring-params-ptr, iocb-ptr, ioctl-request, itimer-which,
    kernel-fd-set-ptr, kernel-itimerspec-ptr, kernel-old-itimerval-ptr, kernel-timespec-ptr,
    kernel-timex-ptr, key, key-serial, linux-dirent64-ptr, loff, loff-ptr, lsm-ctx-ptr,
    madvise-advice, map-flags, mcl-flags, membarrier-cmd, membarrier-cmd-flags, memfd-flags,
    mlock-flags, mmsghdr-array, mode, mount-flags, mq-attr-ptr, mqd, mremap-flags, msg-flags,
    msgbuf-ptr, msqid64-ds-ptr, msync-flags, new-utsname-ptr, open-flags, pid, pollfd-array,
    prctl-option, prio-which, prot-flags, ptrace-request, qid, reboot-cmd, rename-flags,
    rlimit-resource, rlimit64-ptr, robust-list-head-ptr,
    robust-list-head-ptr-ptr, rusage-ptr, rusage-who, rwf-flags, s32-array, s32-ptr,
    sched-attr-ptr, sched-param-ptr, sched-policy, seek-whence, shmid64-ds-ptr, shutdown-how,
    sigaction-ptr, sigaltstack-ptr, siginfo-ptr, signal, signalfd-flags, sigprocmask-how,
    sigset-ptr, slong, sockaddr-ptr, socket-flags, socket-level, socklen, socklen-ptr,
    splice-flags, statfs64-ptr, statx-mask, statx-ptr, sync-file-range-flags, sysinfo-ptr,
    timer-flags, timer-id, timer-id-ptr, timerfd-flags, timerfd-settime-flags, tms-ptr, u32-ptr,
    u64-array, uid, uid-ptr, ulong, ulong-array, umount-flags, uptr, user-cap-data-array,
    user-cap-header-ptr, user-msghdr-ptr, usize, usize-ptr, void-ptr, wait-options, xattr-args-ptr,
    xattr-flags,
  };

  // ==== Files and directories ====

  /// Kernel: `sys_openat(int dfd, const char * filename, int flags, umode_t mode)`.
  /// musl ORs O_LARGEFILE (0100000 on asm-generic) into flags on 32-bit. mode is umode_t (u16) but passed
  /// as full register.
  /// @nr(56)
  openat: func(dfd: fd, filename: cstr, %flags: open-flags, mode: mode) -> slong;

  /// Kernel: `sys_openat2(int dfd, const char * filename, struct open_how * how, size_t usize)`.
  /// struct open_how {u64 flags; u64 mode; u64 resolve} 24 bytes; usize must be >= 24.
  /// @nr(437)
  openat2: func(dfd: fd, filename: cstr, how: const-open-how-ptr, usize: usize) -> slong;

  /// Kernel: `sys_close(unsigned int fd)`.
  /// @nr(57)
  close: func(fd: fd) -> slong;

  /// Kernel: `sys_close_range(unsigned int fd, unsigned int max_fd, unsigned int flags)`.
  /// @nr(436)
  close-range: func(fd: u32, max-fd: u32, %flags: close-range-flags) -> slong;

  /// Kernel: `sys_dup(unsigned int fildes)`.
  /// @nr(23)
  dup: func(fildes: fd) -> slong;

  /// Kernel: `sys_dup3(unsigned int oldfd, unsigned int newfd, int flags)`.
  /// No dup2 on asm-generic: musl dup2 -> dup3 (fails EINVAL if old==new, musl handles via fcntl
  /// F_GETFD).
  /// @nr(24)
  dup3: func(oldfd: fd, newfd: fd, %flags: open-flags) -> slong;

  /// Kernel: `sys_fcntl64(unsigned int fd, unsigned int cmd, unsigned long arg)`.
  /// riscv32 name of fcntl. `F_GETLK64`/`F_SETLK64`/`F_SETLKW64` (12/13/14) and `F_OFD_*` take a
  /// `flock64`; the kernel `F_GETLK`..`F_SETLKW` (5/6/7) take the legacy 16-byte `flock`. musl on riscv32
  /// defines `F_GETLK` as 12, so it only ever passes `flock64`. `F_GETOWN` may return a negative pgid
  /// that looks like `-errno`.
  /// Untyped: arg: an integer, or a guest pointer to `flock64`, `flock`, `f-owner-ex` or `u64`, depending
  /// on `cmd`.
  /// @nr(25)
  fcntl64: func(fd: fd, cmd: fcntl-cmd, arg: ulong) -> slong;

  /// Kernel: `sys_flock(unsigned int fd, unsigned int cmd)`.
  /// BSD flock(2), not fcntl locks.
  /// @nr(32)
  flock: func(fd: fd, cmd: flock-op) -> slong;

  /// Kernel: `sys_ioctl(unsigned int fd, unsigned int cmd, unsigned long arg)`.
  /// Untyped 3rd arg (int or pointer depending on request); request encoding _IOC(dir,type,nr,size) with
  /// asm-generic ioctl.h (size bits 14). Host must know per-request layouts (termios, winsize, FIONREAD,
  /// SIOC*...). musl uses TCGETS/TCSETS*/TIOCGWINSZ/FIONBIO/SIOCGIF* etc.
  /// Untyped: arg: an integer or a guest pointer, depending on `cmd`.
  /// @nr(29)
  ioctl: func(fd: fd, cmd: ioctl-request, arg: ulong) -> slong;

  /// Kernel: `sys_read(unsigned int fd, char * buf, size_t count)`.
  /// @nr(63)
  read: func(fd: fd, buf: buf, count: usize) -> slong;

  /// Kernel: `sys_write(unsigned int fd, const char * buf, size_t count)`.
  /// @nr(64)
  write: func(fd: fd, buf: const-buf, count: usize) -> slong;

  /// Kernel: `sys_readv(unsigned long fd, const struct iovec * vec, unsigned long vlen)`.
  /// struct iovec {void*; size_t} = 8 bytes on wasm32. IOV_MAX 1024.
  /// @nr(65)
  readv: func(fd: fd, vec: const-iovec-array, vlen: ulong) -> slong;

  /// Kernel: `sys_writev(unsigned long fd, const struct iovec * vec, unsigned long vlen)`.
  /// @nr(66)
  writev: func(fd: fd, vec: const-iovec-array, vlen: ulong) -> slong;

  /// Kernel: `sys_pread64(unsigned int fd, char * buf, size_t count, loff_t pos)`.
  /// pos register pair on riscv32 (no padding before the pair on riscv).
  /// @nr(67)
  /// @merged-i64(pos)
  pread64: func(fd: fd, buf: buf, count: usize, pos: loff) -> slong;

  /// Kernel: `sys_pwrite64(unsigned int fd, const char * buf, size_t count, loff_t pos)`.
  /// pos register pair.
  /// @nr(68)
  /// @merged-i64(pos)
  pwrite64: func(fd: fd, buf: const-buf, count: usize, pos: loff) -> slong;

  /// Kernel: `sys_preadv(unsigned long fd, const struct iovec * vec, unsigned long vlen, unsigned long
  /// pos_l, unsigned long pos_h)`.
  /// The kernel takes the position as (pos_l, pos_h) on all arches; here it is one `s64`.
  /// @nr(69)
  /// @merged-i64(pos)
  preadv: func(fd: fd, vec: const-iovec-array, vlen: ulong, pos: s64) -> slong;

  /// Kernel: `sys_pwritev(unsigned long fd, const struct iovec * vec, unsigned long vlen, unsigned long
  /// pos_l, unsigned long pos_h)`.
  /// The kernel takes the position as (pos_l, pos_h) on all arches; here it is one `s64`.
  /// @nr(70)
  /// @merged-i64(pos)
  pwritev: func(fd: fd, vec: const-iovec-array, vlen: ulong, pos: s64) -> slong;

  /// Kernel: `sys_preadv2(unsigned long fd, const struct iovec * vec, unsigned long vlen, unsigned long
  /// pos_l, unsigned long pos_h, rwf_t flags)`.
  /// The kernel takes the position as (pos_l, pos_h); here it is one `s64`. -1 means the current
  /// position.
  /// @nr(286)
  /// @merged-i64(pos)
  preadv2: func(fd: fd, vec: const-iovec-array, vlen: ulong, pos: s64, %flags: rwf-flags) -> slong;

  /// Kernel: `sys_pwritev2(unsigned long fd, const struct iovec * vec, unsigned long vlen, unsigned long
  /// pos_l, unsigned long pos_h, rwf_t flags)`.
  /// The kernel takes the position as (pos_l, pos_h); here it is one `s64`. -1 means the current
  /// position.
  /// @nr(287)
  /// @merged-i64(pos)
  pwritev2: func(fd: fd, vec: const-iovec-array, vlen: ulong, pos: s64, %flags: rwf-flags) -> slong;

  /// Kernel: `sys_llseek(unsigned int fd, unsigned long offset_high, unsigned long offset_low, loff_t *
  /// result, unsigned int whence)`.
  /// The kernel takes the offset as (offset_high, offset_low); here it is one `s64`. The 64-bit result is
  /// written to `result`; the return value is 0 or `-errno`.
  /// @nr(62)
  /// @sys-name(_llseek)
  /// @merged-i64(offset, hi-lo)
  llseek: func(fd: fd, offset: s64, %result: loff-ptr, whence: seek-whence) -> slong;

  /// Kernel: `sys_sendfile64(int out_fd, int in_fd, loff_t * offset, size_t count)`.
  /// riscv32 name sendfile64; offset is loff_t* (64-bit in memory).
  /// @nr(71)
  sendfile64: func(out-fd: fd, in-fd: fd, offset: loff-ptr, count: usize) -> slong;

  /// Kernel: `sys_splice(int fd_in, loff_t * off_in, int fd_out, loff_t * off_out, size_t len, unsigned
  /// int flags)`.
  /// offsets are loff_t* (64-bit in memory).
  /// @nr(76)
  splice: func(
    fd-in: fd,
    off-in: loff-ptr,
    fd-out: fd,
    off-out: loff-ptr,
    len: usize,
    %flags: splice-flags,
  ) -> slong;

  /// Kernel: `sys_tee(int fdin, int fdout, size_t len, unsigned int flags)`.
  /// @nr(77)
  tee: func(fdin: fd, fdout: fd, len: usize, %flags: splice-flags) -> slong;

  /// Kernel: `sys_vmsplice(int fd, const struct iovec * uiov, unsigned long nr_segs, unsigned int
  /// flags)`.
  /// @nr(75)
  vmsplice: func(fd: fd, uiov: const-iovec-array, nr-segs: ulong, %flags: splice-flags) -> slong;

  /// Kernel: `sys_copy_file_range(int fd_in, loff_t * off_in, int fd_out, loff_t * off_out, size_t len,
  /// unsigned int flags)`.
  /// offsets are loff_t*.
  /// @nr(285)
  copy-file-range: func(
    fd-in: fd,
    off-in: loff-ptr,
    fd-out: fd,
    off-out: loff-ptr,
    len: usize,
    %flags: u32,
  ) -> slong;

  /// Kernel: `sys_truncate64(const char * path, loff_t length)`.
  /// riscv32 name truncate64; length register pair.
  /// @nr(45)
  /// @merged-i64(length)
  truncate64: func(path: cstr, length: loff) -> slong;

  /// Kernel: `sys_ftruncate64(unsigned int fd, loff_t length)`.
  /// riscv32 name ftruncate64; length register pair.
  /// @nr(46)
  /// @merged-i64(length)
  ftruncate64: func(fd: fd, length: loff) -> slong;

  /// Kernel: `sys_fallocate(int fd, int mode, loff_t offset, loff_t len)`.
  /// offset/len register pairs.
  /// @nr(47)
  /// @merged-i64(offset)
  /// @merged-i64(len)
  fallocate: func(fd: fd, mode: falloc-flags, offset: loff, len: loff) -> slong;

  /// Kernel: `sys_fadvise64_64(int fd, loff_t offset, loff_t len, int advice)`.
  /// riscv32 name fadvise64_64 (64-only table has fadvise64). Logical (int fd, loff_t offset, loff_t len,
  /// int advice); riscv32 passes offset and len as register pairs and does NOT reorder args (unlike
  /// arm/ppc fadvise64_64 with advice second).
  /// @nr(223)
  /// @merged-i64(offset)
  /// @merged-i64(len)
  fadvise64-64: func(fd: fd, offset: loff, len: loff, advice: fadvise-advice) -> slong;

  /// Kernel: `sys_readahead(int fd, loff_t offset, size_t count)`.
  /// offset register pair.
  /// @nr(213)
  /// @merged-i64(offset)
  readahead: func(fd: fd, offset: loff, count: usize) -> slong;

  /// Kernel: `sys_sync()`.
  /// @nr(81)
  sync: func() -> slong;

  /// Kernel: `sys_fsync(unsigned int fd)`.
  /// @nr(82)
  fsync: func(fd: fd) -> slong;

  /// Kernel: `sys_fdatasync(unsigned int fd)`.
  /// @nr(83)
  fdatasync: func(fd: fd) -> slong;

  /// Kernel: `sys_syncfs(int fd)`.
  /// @nr(267)
  syncfs: func(fd: fd) -> slong;

  /// Kernel: `sys_sync_file_range(int fd, loff_t offset, loff_t nbytes, unsigned int flags)`.
  /// riscv32 uses sync_file_range (not sync_file_range2); offset/nbytes are register pairs on riscv32.
  /// @nr(84)
  /// @merged-i64(offset)
  /// @merged-i64(nbytes)
  sync-file-range: func(fd: fd, offset: loff, nbytes: loff, %flags: sync-file-range-flags) -> slong;

  /// Kernel: `sys_getdents64(unsigned int fd, struct linux_dirent64 * dirent, unsigned int count)`.
  /// struct linux_dirent64 records, 8-byte aligned reclen.
  /// @nr(61)
  getdents64: func(fd: fd, dirent: linux-dirent64-ptr, count: u32) -> slong;

  /// Kernel: `sys_mkdirat(int dfd, const char * pathname, umode_t mode)`.
  /// @nr(34)
  mkdirat: func(dfd: fd, pathname: cstr, mode: mode) -> slong;

  /// Kernel: `sys_mknodat(int dfd, const char * filename, umode_t mode, unsigned int dev)`.
  /// dev is u32 in new_encode_dev format (major<<8 low bits... see kdev_t.h).
  /// @nr(33)
  mknodat: func(dfd: fd, filename: cstr, mode: mode, dev: u32) -> slong;

  /// Kernel: `sys_unlinkat(int dfd, const char * pathname, int flag)`.
  /// No unlink/rmdir: AT_REMOVEDIR flag.
  /// @nr(35)
  unlinkat: func(dfd: fd, pathname: cstr, flag: at-flags) -> slong;

  /// Kernel: `sys_symlinkat(const char * oldname, int newdfd, const char * newname)`.
  /// @nr(36)
  symlinkat: func(oldname: cstr, newdfd: fd, newname: cstr) -> slong;

  /// Kernel: `sys_linkat(int olddfd, const char * oldname, int newdfd, const char * newname, int flags)`.
  /// @nr(37)
  linkat: func(olddfd: fd, oldname: cstr, newdfd: fd, newname: cstr, %flags: at-flags) -> slong;

  /// Kernel: `sys_renameat2(int olddfd, const char * oldname, int newdfd, const char * newname, unsigned
  /// int flags)`.
  /// No renameat on riscv32 (renameat abi not enabled): musl rename/renameat -> renameat2(..., 0).
  /// @nr(276)
  renameat2: func(olddfd: fd, oldname: cstr, newdfd: fd, newname: cstr, %flags: rename-flags) -> slong;

  /// Kernel: `sys_readlinkat(int dfd, const char * pathname, char * buf, int bufsiz)`.
  /// returns byte count, no NUL terminator.
  /// @nr(78)
  readlinkat: func(dfd: fd, pathname: cstr, buf: buf, bufsiz: s32) -> slong;

  /// Kernel: `sys_faccessat(int dfd, const char * filename, int mode)`.
  /// No access(2): AT_FDCWD.
  /// @nr(48)
  faccessat: func(dfd: fd, filename: cstr, mode: access-mode) -> slong;

  /// Kernel: `sys_faccessat2(int dfd, const char * filename, int mode, int flags)`.
  /// musl faccessat with flags tries faccessat2 first.
  /// @nr(439)
  faccessat2: func(dfd: fd, filename: cstr, mode: access-mode, %flags: at-flags) -> slong;

  /// Kernel: `sys_chdir(const char * filename)`.
  /// @nr(49)
  chdir: func(filename: cstr) -> slong;

  /// Kernel: `sys_fchdir(unsigned int fd)`.
  /// @nr(50)
  fchdir: func(fd: fd) -> slong;

  /// Kernel: `sys_chroot(const char * filename)`.
  /// @nr(51)
  chroot: func(filename: cstr) -> slong;

  /// Kernel: `sys_fchroot(int fd, unsigned int flags)`.
  /// @nr(472)
  fchroot: func(fd: fd, %flags: u32) -> slong;

  /// Kernel: `sys_getcwd(char * buf, unsigned long size)`.
  /// @nr(17)
  getcwd: func(buf: buf, size: ulong) -> slong;

  /// Kernel: `sys_fchmod(unsigned int fd, umode_t mode)`.
  /// @nr(52)
  fchmod: func(fd: fd, mode: mode) -> slong;

  /// Kernel: `sys_fchmodat(int dfd, const char * filename, umode_t mode)`.
  /// @nr(53)
  fchmodat: func(dfd: fd, filename: cstr, mode: mode) -> slong;

  /// Kernel: `sys_fchmodat2(int dfd, const char * filename, umode_t mode, unsigned int flags)`.
  /// musl fchmodat(AT_SYMLINK_NOFOLLOW) tries fchmodat2 first.
  /// @nr(452)
  fchmodat2: func(dfd: fd, filename: cstr, mode: mode, %flags: at-flags) -> slong;

  /// Kernel: `sys_fchown(unsigned int fd, uid_t user, gid_t group)`.
  /// @nr(55)
  fchown: func(fd: fd, user: uid, group: gid) -> slong;

  /// Kernel: `sys_fchownat(int dfd, const char * filename, uid_t user, gid_t group, int flag)`.
  /// @nr(54)
  fchownat: func(dfd: fd, filename: cstr, user: uid, group: gid, flag: at-flags) -> slong;

  /// Kernel: `sys_statx(int dfd, const char * filename, unsigned flags, unsigned int mask, struct statx *
  /// buffer)`.
  /// Only stat syscall on riscv32 (no fstatat64/newfstatat/fstat): musl implements
  /// stat/fstat/lstat/fstatat via statx and converts to its struct stat. struct statx = 256 bytes. musl
  /// fstat(fd) uses statx(fd, "", AT_EMPTY_PATH, ...).
  /// @nr(291)
  statx: func(dfd: fd, filename: cstr, %flags: at-flags, mask: statx-mask, buffer: statx-ptr) -> slong;

  /// Kernel: `sys_statfs64(const char * pathname, size_t sz, struct statfs64 * buf)`.
  /// sz must be sizeof(struct statfs64) == 88 on riscv32/wasm32 (asm-generic: __statfs_word is u32 on
  /// 32-bit).
  /// @nr(43)
  statfs64: func(pathname: cstr, sz: usize, buf: statfs64-ptr) -> slong;

  /// Kernel: `sys_fstatfs64(unsigned int fd, size_t sz, struct statfs64 * buf)`.
  /// sz must be sizeof(struct statfs64) == 88.
  /// @nr(44)
  fstatfs64: func(fd: fd, sz: usize, buf: statfs64-ptr) -> slong;

  /// Kernel: `sys_utimensat(int dfd, const char * filename, struct __kernel_timespec * utimes, int
  /// flags)`.
  /// times[2] of timespec64 (32 bytes), UTIME_NOW/UTIME_OMIT in tv_nsec. filename NULL allowed
  /// (futimens).
  /// @nr(412)
  utimensat-time64: func(
    dfd: fd,
    filename: cstr,
    utimes: const-kernel-timespec-array,
    %flags: at-flags,
  ) -> slong;

  /// Kernel: `sys_pipe2(int * fildes, int flags)`.
  /// fildes is int[2].
  /// @nr(59)
  pipe2: func(fildes: fd-pair, %flags: open-flags) -> slong;

  /// Kernel: `sys_memfd_create(const char * uname, unsigned int flags)`.
  /// @nr(279)
  memfd-create: func(uname: cstr, %flags: memfd-flags) -> slong;

  /// Kernel: `sys_memfd_secret(unsigned int flags)`.
  /// Enabled on riscv via memfd_secret abi (syscall_abis_32 += riscv memfd_secret).
  /// @nr(447)
  memfd-secret: func(%flags: u32) -> slong;

  /// Kernel: `sys_name_to_handle_at(int dfd, const char * name, struct file_handle * handle, void *
  /// mnt_id, int flag)`.
  /// struct file_handle {u32 handle_bytes; int handle_type; u8 f_handle[]} 8-byte header.
  /// Untyped: mnt-id: `int *`, or `u64 *` with `AT_HANDLE_MNT_ID_UNIQUE`.
  /// @nr(264)
  name-to-handle-at: func(dfd: fd, name: cstr, handle: file-handle-ptr, mnt-id: s32-ptr, flag: s32) -> slong;

  /// Kernel: `sys_open_by_handle_at(int mountdirfd, struct file_handle * handle, int flags)`.
  /// @nr(265)
  open-by-handle-at: func(mountdirfd: fd, handle: const-file-handle-ptr, %flags: open-flags) -> slong;

  /// Kernel: `sys_cachestat(unsigned int fd, struct cachestat_range * cstat_range, struct cachestat *
  /// cstat, unsigned int flags)`.
  /// struct cachestat_range {u64 off; u64 len}; struct cachestat 5 x u64.
  /// @nr(451)
  cachestat: func(fd: fd, cstat-range: const-cachestat-range-ptr, cstat: cachestat-ptr, %flags: u32) -> slong;

  /// Kernel: `sys_file_getattr(int dfd, const char * filename, struct file_attr * ufattr, size_t usize,
  /// unsigned int at_flags)`.
  /// @nr(468)
  file-getattr: func(
    dfd: fd,
    filename: cstr,
    ufattr: file-attr-ptr,
    usize: usize,
    at-flags: at-flags,
  ) -> slong;

  /// Kernel: `sys_file_setattr(int dfd, const char * filename, struct file_attr * ufattr, size_t usize,
  /// unsigned int at_flags)`.
  /// @nr(469)
  file-setattr: func(
    dfd: fd,
    filename: cstr,
    ufattr: const-file-attr-ptr,
    usize: usize,
    at-flags: at-flags,
  ) -> slong;

  /// Kernel: `sys_quotactl(unsigned int cmd, const char * special, qid_t id, void * addr)`.
  /// addr type depends on cmd.
  /// Untyped: addr: pointee depends on `cmd`.
  /// @nr(60)
  quotactl: func(cmd: u32, special: cstr, id: qid, addr: void-ptr) -> slong;

  /// Kernel: `sys_quotactl_fd(unsigned int fd, unsigned int cmd, qid_t id, void * addr)`.
  /// Untyped: addr: pointee depends on `cmd`.
  /// @nr(443)
