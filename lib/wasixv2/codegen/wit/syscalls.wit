    ufd: fd,
    %flags: timerfd-settime-flags,
    utmr: const-kernel-itimerspec-ptr,
    otmr: kernel-itimerspec-ptr,
  ) -> slong;

  /// Kernel: `sys_timerfd_gettime(int ufd, struct __kernel_itimerspec * otmr)`.
  /// @nr(410)
  timerfd-gettime64: func(ufd: fd, otmr: kernel-itimerspec-ptr) -> slong;

  /// Kernel: `sys_inotify_init1(int flags)`.
  /// No inotify_init.
  /// @nr(26)
  inotify-init1: func(%flags: inotify-init-flags) -> slong;

  /// Kernel: `sys_inotify_add_watch(int fd, const char * pathname, u32 mask)`.
  /// @nr(27)
  inotify-add-watch: func(fd: fd, pathname: cstr, mask: inotify-mask) -> slong;

  /// Kernel: `sys_inotify_rm_watch(int fd, __s32 wd)`.
  /// @nr(28)
  inotify-rm-watch: func(fd: fd, wd: s32) -> slong;

  /// Kernel: `sys_fanotify_init(unsigned int flags, unsigned int event_f_flags)`.
  /// @nr(262)
  fanotify-init: func(%flags: u32, event-f-flags: u32) -> slong;

  /// Kernel: `sys_fanotify_mark(int fanotify_fd, unsigned int flags, __u64 mask, int dfd, const char *
  /// pathname)`.
  /// __u64 mask: register pair on riscv32.
  /// @nr(263)
  /// @merged-i64(mask)
  fanotify-mark: func(fanotify-fd: fd, %flags: u32, mask: u64, dfd: fd, pathname: cstr) -> slong;

  // ==== Signals ====

  /// Kernel: `sys_rt_sigaction(int sig, const struct sigaction * act, struct sigaction * oact, size_t
  /// sigsetsize)`.
  /// Kernel struct sigaction on riscv (asm-generic, riscv does NOT define
  /// SA_RESTORER/__ARCH_HAS_SA_RESTORER): {sighandler_t handler; unsigned long sa_flags; sigset_t sa_mask
  /// (8 bytes)} = 16 bytes on ILP32, mask at offset 8. sigsetsize must be 8. MUSL BUG: musl riscv32
  /// (v1.2.6 and master b1efda5b) defines SA_RESTORER 0x04000000 in arch/riscv32/bits/signal.h, so its
  /// struct k_sigaction is {handler, flags, restorer, mask[2]} (mask at offset 12) - the same bug musl
  /// commit 269d1938 (2023) fixed for riscv64/mips/or1k/microblaze but riscv32 (merged 2024 from 2020
  /// headers) reintroduced. For WASIX, follow the kernel layout (16 bytes, no restorer).
  /// @nr(134)
  rt-sigaction: func(sig: signal, act: const-sigaction-ptr, oact: sigaction-ptr, sigsetsize: usize) -> slong;

  /// Kernel: `sys_rt_sigprocmask(int how, sigset_t * nset, sigset_t * oset, size_t sigsetsize)`.
  /// sigsetsize must be 8.
  /// @nr(135)
  rt-sigprocmask: func(
    how: sigprocmask-how,
    nset: const-sigset-ptr,
    oset: sigset-ptr,
    sigsetsize: usize,
  ) -> slong;

  /// Kernel: `sys_rt_sigpending(sigset_t * uset, size_t sigsetsize)`.
  /// sigsetsize must be 8.
  /// @nr(136)
  rt-sigpending: func(uset: sigset-ptr, sigsetsize: usize) -> slong;

  /// Kernel: `sys_rt_sigsuspend(sigset_t * unewset, size_t sigsetsize)`.
  /// sigsetsize must be 8.
  /// @nr(133)
  rt-sigsuspend: func(unewset: const-sigset-ptr, sigsetsize: usize) -> slong;

  /// Kernel: `sys_rt_sigtimedwait(const sigset_t * uthese, siginfo_t * uinfo, const struct
  /// __kernel_timespec * uts, size_t sigsetsize)`.
  /// sigsetsize must be 8. siginfo 128 bytes.
  /// @nr(421)
  rt-sigtimedwait-time64: func(
    uthese: const-sigset-ptr,
    uinfo: siginfo-ptr,
    uts: const-kernel-timespec-ptr,
    sigsetsize: usize,
  ) -> slong;

  /// Kernel: `sys_rt_sigqueueinfo(pid_t pid, int sig, siginfo_t * uinfo)`.
  /// siginfo_t 128 bytes.
  /// @nr(138)
  rt-sigqueueinfo: func(pid: pid, sig: signal, uinfo: const-siginfo-ptr) -> slong;

  /// Kernel: `sys_rt_tgsigqueueinfo(pid_t tgid, pid_t pid, int sig, siginfo_t * uinfo)`.
  /// siginfo_t 128 bytes.
  /// @nr(240)
  rt-tgsigqueueinfo: func(tgid: pid, pid: pid, sig: signal, uinfo: const-siginfo-ptr) -> slong;

  /// Kernel: `sys_rt_sigreturn()`.
  /// Restores the signal frame (ucontext/mcontext on user stack). musl calls it from __restore_rt
  /// trampoline (src/signal/riscv32/restore.s), riscv uses a vDSO trampoline. In wasm this needs a
  /// host-specific design (no user-visible register frame).
  /// @nr(139)
  /// @noreturn
  rt-sigreturn: func();

  /// Kernel: `sys_sigaltstack(const stack_t * uss, stack_t * uoss)`.
  /// stack_t = 12 bytes on ILP32 {void* ss_sp; int ss_flags; size_t ss_size}. MINSIGSTKSZ/SIGSTKSZ arch
  /// constants (musl riscv32: 2048/8192).
  /// @nr(132)
  sigaltstack: func(uss: const-sigaltstack-ptr, uoss: sigaltstack-ptr) -> slong;

  /// Kernel: `sys_kill(pid_t pid, int sig)`.
  /// @nr(129)
  kill: func(pid: pid, sig: signal) -> slong;

  /// Kernel: `sys_tkill(pid_t pid, int sig)`.
  /// @nr(130)
  tkill: func(pid: pid, sig: signal) -> slong;

  /// Kernel: `sys_tgkill(pid_t tgid, pid_t pid, int sig)`.
  /// @nr(131)
  tgkill: func(tgid: pid, pid: pid, sig: signal) -> slong;

  /// Kernel: `sys_pidfd_send_signal(int pidfd, int sig, siginfo_t * info, unsigned int flags)`.
  /// @nr(424)
  pidfd-send-signal: func(pidfd: fd, sig: signal, info: const-siginfo-ptr, %flags: u32) -> slong;

  /// Kernel: `sys_restart_syscall()`.
  /// Kernel-internal restart mechanism; not called by libc.
  /// @nr(128)
  restart-syscall: func() -> slong;

  // ==== Processes and threads ====

  /// Kernel: `sys_clone(unsigned long clone_flags, unsigned long newsp, int * parent_tidptr, unsigned
  /// long tls, int * child_tidptr)`.
  /// riscv uses CLONE_BACKWARDS order: (flags, newsp, parent_tid, tls, child_tid). Returns twice (0 in
  /// the child running on `newsp`), which a wasm import cannot do; threads need `wasix_ext.thread-spawn`
  /// and fork/vfork need a host design.
  /// @nr(220)
  clone: func(
    clone-flags: ulong,
    newsp: uptr,
    parent-tidptr: s32-ptr,
    tls: uptr,
    child-tidptr: s32-ptr,
  ) -> slong;

  /// Kernel: `sys_clone3(struct clone_args * uargs, size_t size)`.
  /// struct clone_args: all fields __aligned_u64; size 88 (VER2). Same return-twice issue as clone. Not
  /// used by musl.
  /// @nr(435)
  clone3: func(uargs: const-clone-args-ptr, size: usize) -> slong;

  /// Kernel: `sys_execve(const char * filename, const char *const * argv, const char *const * envp)`.
  /// Replaces process image; no return on success. argv/envp are NULL-terminated arrays of 32-bit
  /// pointers.
  /// @nr(221)
  execve: func(filename: cstr, argv: cstr-array, envp: cstr-array) -> slong;

  /// Kernel: `sys_execveat(int fd, const char * filename, const char *const * argv, const char *const *
  /// envp, int flags)`.
  /// AT_EMPTY_PATH for fexecve.
  /// @nr(281)
  execveat: func(fd: fd, filename: cstr, argv: cstr-array, envp: cstr-array, %flags: at-flags) -> slong;

  /// Kernel: `sys_exit(int error_code)`.
  /// Exits only the calling thread. noreturn.
  /// @nr(93)
  /// @noreturn
  exit: func(error-code: s32);

  /// Kernel: `sys_exit_group(int error_code)`.
  /// noreturn.
  /// @nr(94)
  /// @noreturn
  exit-group: func(error-code: s32);

  /// Kernel: `sys_waitid(int which, pid_t upid, struct siginfo * infop, int options, struct rusage *
  /// ru)`.
  /// Also the only wait primitive on riscv32 (no wait4): musl implements wait4/waitpid via
  /// waitid(P_ALL/P_PID/P_PGID/P_PIDFD) + rusage. 5th arg struct rusage uses __kernel_old_timeval with
  /// 32-bit tv_sec/tv_usec (long) on riscv32 => y2038-limited; kernel struct rusage = 72 bytes on ILP32
  /// (see types.md).
  /// @nr(95)
  waitid: func(which: idtype, upid: pid, infop: siginfo-ptr, options: wait-options, ru: rusage-ptr) -> slong;

  /// Kernel: `sys_set_tid_address(int * tidptr)`.
  /// Sets clear_child_tid: kernel writes 0 to *tidptr and futex-wakes it on thread exit. Returns caller
  /// tid. musl uses it at startup and in pthread_create via clone CLONE_CHILD_CLEARTID.
  /// @nr(96)
  set-tid-address: func(tidptr: s32-ptr) -> slong;

  /// Kernel: `sys_unshare(unsigned long unshare_flags)`.
  /// @nr(97)
  unshare: func(unshare-flags: ulong) -> slong;

  /// Kernel: `sys_setns(int fd, int flags)`.
  /// @nr(268)
  setns: func(fd: fd, %flags: s32) -> slong;

  /// Kernel: `sys_getpid()`.
  /// @nr(172)
  getpid: func() -> slong;

  /// Kernel: `sys_getppid()`.
  /// @nr(173)
  getppid: func() -> slong;

  /// Kernel: `sys_gettid()`.
  /// @nr(178)
  gettid: func() -> slong;

  /// Kernel: `sys_getpgid(pid_t pid)`.
  /// @nr(155)
  getpgid: func(pid: pid) -> slong;

  /// Kernel: `sys_setpgid(pid_t pid, pid_t pgid)`.
  /// @nr(154)
  setpgid: func(pid: pid, pgid: pid) -> slong;

  /// Kernel: `sys_getsid(pid_t pid)`.
  /// @nr(156)
  getsid: func(pid: pid) -> slong;

  /// Kernel: `sys_setsid()`.
  /// @nr(157)
  setsid: func() -> slong;

  /// Kernel: `sys_pidfd_open(pid_t pid, unsigned int flags)`.
  /// @nr(434)
  pidfd-open: func(pid: pid, %flags: u32) -> slong;

  /// Kernel: `sys_pidfd_getfd(int pidfd, int fd, unsigned int flags)`.
  /// @nr(438)
  pidfd-getfd: func(pidfd: fd, fd: fd, %flags: u32) -> slong;

  /// Kernel: `sys_process_mrelease(int pidfd, unsigned int flags)`.
  /// @nr(448)
  process-mrelease: func(pidfd: fd, %flags: u32) -> slong;

  /// Kernel: `sys_kcmp(pid_t pid1, pid_t pid2, int type, unsigned long idx1, unsigned long idx2)`.
  /// @nr(272)
  kcmp: func(pid1: pid, pid2: pid, %type: s32, idx1: ulong, idx2: ulong) -> slong;

  /// Kernel: `sys_personality(unsigned int personality)`.
  /// @nr(92)
  personality: func(personality: u32) -> slong;

  /// Kernel: `sys_prctl(int option, unsigned long arg2, unsigned long arg3, unsigned long arg4, unsigned
  /// long arg5)`.
  /// Untyped args (int or pointer depending on option, e.g. PR_SET_NAME takes char*[16]).
  /// Untyped: arg2..arg5: integers or guest pointers, depending on `option`.
  /// @nr(167)
  prctl: func(%option: prctl-option, arg2: ulong, arg3: ulong, arg4: ulong, arg5: ulong) -> slong;

  /// Kernel: `sys_ptrace(long request, long pid, unsigned long addr, unsigned long data)`.
  /// Raw kernel semantics: PTRACE_PEEK* store result to *data (glibc/musl wrapper returns it). musl
  /// ptrace() wrapper does this.
  /// Untyped: data: an integer or a guest pointer, depending on `request` (`PTRACE_PEEK*` store the word
  /// at `data`).
  /// @nr(117)
  ptrace: func(request: ptrace-request, pid: pid, addr: uptr, data: ulong) -> slong;

  /// Kernel: `sys_process_vm_readv(pid_t pid, const struct iovec * lvec, unsigned long liovcnt, const
  /// struct iovec * rvec, unsigned long riovcnt, unsigned long flags)`.
  /// @nr(270)
  process-vm-readv: func(
    pid: pid,
    lvec: const-iovec-array,
    liovcnt: ulong,
    rvec: const-iovec-array,
    riovcnt: ulong,
    %flags: ulong,
  ) -> slong;

  /// Kernel: `sys_process_vm_writev(pid_t pid, const struct iovec * lvec, unsigned long liovcnt, const
  /// struct iovec * rvec, unsigned long riovcnt, unsigned long flags)`.
  /// @nr(271)
  process-vm-writev: func(
    pid: pid,
    lvec: const-iovec-array,
    liovcnt: ulong,
    rvec: const-iovec-array,
    riovcnt: ulong,
    %flags: ulong,
  ) -> slong;

  /// Kernel: `sys_seccomp(unsigned int op, unsigned int flags, void * uargs)`.
  /// Untyped: uargs: pointee depends on `op`.
  /// @nr(277)
  seccomp: func(op: u32, %flags: u32, uargs: void-ptr) -> slong;

  /// Kernel: `sys_rseq(struct rseq * rseq, u32 rseq_len, int flags, u32 sig)`.
  /// struct rseq is 32-byte aligned (__attribute__((aligned(32))) in uapi). Registered by glibc, not
  /// musl.
  /// Untyped: rseq: `struct rseq` (64 bytes, 32-byte aligned, not modelled: WIT records cannot express
  /// over-alignment).
  /// @nr(293)
  rseq: func(rseq: void-ptr, rseq-len: u32, %flags: s32, sig: u32) -> slong;

  /// Kernel: `sys_rseq_slice_yield()`.
  /// @nr(471)
  rseq-slice-yield: func() -> slong;

  /// Kernel: `sys_set_robust_list(struct robust_list_head * head, size_t len)`.
  /// len must be sizeof(struct robust_list_head) == 12 on ILP32.
  /// @nr(99)
  set-robust-list: func(head: robust-list-head-ptr, len: usize) -> slong;

  /// Kernel: `sys_get_robust_list(int pid, struct robust_list_head * * head_ptr, size_t * len_ptr)`.
  /// @nr(100)
  get-robust-list: func(pid: s32, head-ptr: robust-list-head-ptr-ptr, len-ptr: usize-ptr) -> slong;

