  /// Kernel: `sys_mseal(unsigned long start, size_t len, unsigned long flags)`.
  /// @nr(462)
  mseal: func(start: uptr, len: usize, %flags: ulong) -> slong;

  /// Kernel: `sys_map_shadow_stack(unsigned long addr, unsigned long size, unsigned int flags)`.
  /// Common in table; riscv implements it (arch/riscv/kernel/usercfi.c) for Zicfiss. Irrelevant for wasm.
  /// @nr(453)
  /// @unsupported
  map-shadow-stack: func(addr: uptr, size: ulong, %flags: u32) -> slong;

  /// Kernel: `sys_userfaultfd(int flags)`.
  /// @nr(282)
  userfaultfd: func(%flags: s32) -> slong;

  // ==== Clocks and timers ====

  /// Kernel: `sys_clock_gettime(const clockid_t which_clock, struct __kernel_timespec * tp)`.
  /// riscv32 name clock_gettime64 (entry sys_clock_gettime). musl tries vDSO __vdso_clock_gettime first
  /// (VDSO_CGT_SYM, LINUX_4.15) then syscall. timespec64 = {s64 tv_sec; long tv_nsec; 4 bytes pad} 16
  /// bytes.
  /// @nr(403)
  clock-gettime64: func(which-clock: clock-id, tp: kernel-timespec-ptr) -> slong;

  /// Kernel: `sys_clock_settime(const clockid_t which_clock, const struct __kernel_timespec * tp)`.
  /// @nr(404)
  clock-settime64: func(which-clock: clock-id, tp: const-kernel-timespec-ptr) -> slong;

  /// Kernel: `sys_clock_getres(const clockid_t which_clock, struct __kernel_timespec * tp)`.
  /// @nr(406)
  clock-getres-time64: func(which-clock: clock-id, tp: kernel-timespec-ptr) -> slong;

  /// Kernel: `sys_clock_nanosleep(const clockid_t which_clock, int flags, const struct __kernel_timespec
  /// * rqtp, struct __kernel_timespec * rmtp)`.
  /// No nanosleep on riscv32: musl nanosleep()/sleep()/usleep() -> clock_nanosleep(CLOCK_REALTIME, 0,
  /// ...). Returns -errno directly (POSIX clock_nanosleep returns positive errno; libc converts).
  /// @nr(407)
  clock-nanosleep-time64: func(
    which-clock: clock-id,
    %flags: timer-flags,
    rqtp: const-kernel-timespec-ptr,
    rmtp: kernel-timespec-ptr,
  ) -> slong;

  /// Kernel: `sys_clock_adjtime(const clockid_t which_clock, struct __kernel_timex * utx)`.
  /// struct __kernel_timex: 208 bytes, 64-bit time fields (time64 variant). musl adjtimex() ->
  /// clock_adjtime(CLOCK_REALTIME).
  /// @nr(405)
  clock-adjtime64: func(which-clock: clock-id, utx: kernel-timex-ptr) -> slong;

  /// Kernel: `sys_getitimer(int which, struct __kernel_old_itimerval * value)`.
  /// Uses struct __kernel_old_itimerval (two __kernel_old_timeval, long fields => 32-bit tv_sec on
  /// riscv32, 16 bytes total). y2038 legacy; musl converts on 32-bit.
  /// @nr(102)
  getitimer: func(which: itimer-which, value: kernel-old-itimerval-ptr) -> slong;

  /// Kernel: `sys_setitimer(int which, struct __kernel_old_itimerval * value, struct
  /// __kernel_old_itimerval * ovalue)`.
  /// Uses struct __kernel_old_itimerval (32-bit fields on riscv32). musl converts; values > INT32 seconds
  /// fail with EOVERFLOW-like handling in musl.
  /// @nr(103)
  setitimer: func(
    which: itimer-which,
    value: const-kernel-old-itimerval-ptr,
    ovalue: kernel-old-itimerval-ptr,
  ) -> slong;

  /// Kernel: `sys_timer_create(const clockid_t which_clock, struct sigevent * timer_event_spec, timer_t *
  /// created_timer_id)`.
  /// struct sigevent: 64 bytes (SIGEV_THREAD_ID uses _tid). musl SIGEV_THREAD implemented in userland via
  /// helper thread + SIGEV_THREAD_ID.
  /// @nr(107)
  timer-create: func(
    which-clock: clock-id,
    timer-event-spec: const-sigevent-ptr,
    created-timer-id: timer-id-ptr,
  ) -> slong;

  /// Kernel: `sys_timer_settime(timer_t timer_id, int flags, const struct __kernel_itimerspec *
  /// new_setting, struct __kernel_itimerspec * old_setting)`.
  /// struct __kernel_itimerspec = 2 x timespec64 = 32 bytes.
  /// @nr(409)
  timer-settime64: func(
    timer-id: timer-id,
    %flags: timer-flags,
    new-setting: const-kernel-itimerspec-ptr,
    old-setting: kernel-itimerspec-ptr,
  ) -> slong;

  /// Kernel: `sys_timer_gettime(timer_t timer_id, struct __kernel_itimerspec * setting)`.
  /// @nr(408)
  timer-gettime64: func(timer-id: timer-id, setting: kernel-itimerspec-ptr) -> slong;

  /// Kernel: `sys_timer_getoverrun(timer_t timer_id)`.
  /// @nr(109)
  timer-getoverrun: func(timer-id: timer-id) -> slong;

  /// Kernel: `sys_timer_delete(timer_t timer_id)`.
  /// @nr(111)
  timer-delete: func(timer-id: timer-id) -> slong;

  // ==== Sockets ====

  /// Kernel: `sys_socket(int family, int type, int protocol)`.
  /// SOCK_NONBLOCK=O_NONBLOCK(04000), SOCK_CLOEXEC=O_CLOEXEC(02000000) on asm-generic.
  /// @nr(198)
  socket: func(family: address-family, %type: s32, protocol: s32) -> slong;

  /// Kernel: `sys_socketpair(int family, int type, int protocol, int * usockvec)`.
  /// @nr(199)
  socketpair: func(family: address-family, %type: s32, protocol: s32, usockvec: fd-pair) -> slong;

  /// Kernel: `sys_bind(int fd, struct sockaddr * umyaddr, int addrlen)`.
  /// @nr(200)
  bind: func(fd: fd, umyaddr: const-sockaddr-ptr, addrlen: socklen) -> slong;

  /// Kernel: `sys_listen(int fd, int backlog)`.
  /// @nr(201)
  listen: func(fd: fd, backlog: s32) -> slong;

  /// Kernel: `sys_accept(int fd, struct sockaddr * upeer_sockaddr, int * upeer_addrlen)`.
  /// musl defines SYS_accept to SYS_accept4 only if SYS_accept is missing; riscv32 has both.
  /// @nr(202)
  accept: func(fd: fd, upeer-sockaddr: sockaddr-ptr, upeer-addrlen: socklen-ptr) -> slong;

  /// Kernel: `sys_accept4(int fd, struct sockaddr * upeer_sockaddr, int * upeer_addrlen, int flags)`.
  /// @nr(242)
  accept4: func(
    fd: fd,
    upeer-sockaddr: sockaddr-ptr,
    upeer-addrlen: socklen-ptr,
    %flags: socket-flags,
  ) -> slong;

  /// Kernel: `sys_connect(int fd, struct sockaddr * uservaddr, int addrlen)`.
  /// @nr(203)
  connect: func(fd: fd, uservaddr: const-sockaddr-ptr, addrlen: socklen) -> slong;

  /// Kernel: `sys_getsockname(int fd, struct sockaddr * usockaddr, int * usockaddr_len)`.
  /// @nr(204)
  getsockname: func(fd: fd, usockaddr: sockaddr-ptr, usockaddr-len: socklen-ptr) -> slong;

  /// Kernel: `sys_getpeername(int fd, struct sockaddr * usockaddr, int * usockaddr_len)`.
  /// @nr(205)
  getpeername: func(fd: fd, usockaddr: sockaddr-ptr, usockaddr-len: socklen-ptr) -> slong;

  /// Kernel: `sys_sendto(int fd, void * buff, size_t len, unsigned int flags, struct sockaddr * addr, int
  /// addr_len)`.
  /// @nr(206)
  sendto: func(
    fd: fd,
    buff: const-buf,
    len: usize,
    %flags: msg-flags,
    addr: const-sockaddr-ptr,
    addr-len: socklen,
  ) -> slong;

  /// Kernel: `sys_recvfrom(int fd, void * ubuf, size_t size, unsigned int flags, struct sockaddr * addr,
  /// int * addr_len)`.
  /// @nr(207)
  recvfrom: func(
    fd: fd,
    ubuf: buf,
    size: usize,
    %flags: msg-flags,
    addr: sockaddr-ptr,
    addr-len: socklen-ptr,
  ) -> slong;

  /// Kernel: `sys_setsockopt(int fd, int level, int optname, char * optval, int optlen)`.
  /// optval layouts per (level,optname). SO_RCVTIMEO/SO_SNDTIMEO: on 32-bit,
  /// SO_RCVTIMEO_OLD(20)/SNDTIMEO_OLD(21) take 32-bit timeval; SO_RCVTIMEO_NEW(66)/SO_SNDTIMEO_NEW(67)
  /// take 64-bit __kernel_sock_timeval. musl tries _NEW first on 32-bit time64 archs then falls back.
  /// @nr(208)
  setsockopt: func(fd: fd, level: socket-level, optname: s32, optval: const-buf, optlen: socklen) -> slong;

  /// Kernel: `sys_getsockopt(int fd, int level, int optname, char * optval, int * optlen)`.
  /// see setsockopt.
  /// @nr(209)
  getsockopt: func(fd: fd, level: socket-level, optname: s32, optval: buf, optlen: socklen-ptr) -> slong;

  /// Kernel: `sys_shutdown(int fd, int how)`.
  /// @nr(210)
  shutdown: func(fd: fd, how: shutdown-how) -> slong;

  /// Kernel: `sys_sendmsg(int fd, struct user_msghdr * msg, unsigned int flags)`.
  /// struct user_msghdr = 28 bytes on ILP32; cmsghdr {size_t len; int level; int type} 12 bytes,
  /// CMSG_ALIGN to sizeof(long)=4.
  /// @nr(211)
  sendmsg: func(fd: fd, msg: const-user-msghdr-ptr, %flags: msg-flags) -> slong;

  /// Kernel: `sys_recvmsg(int fd, struct user_msghdr * msg, unsigned int flags)`.
  /// see sendmsg. SCM_TIMESTAMP*_OLD vs _NEW differ on 32-bit.
  /// @nr(212)
  recvmsg: func(fd: fd, msg: user-msghdr-ptr, %flags: msg-flags) -> slong;

  /// Kernel: `sys_sendmmsg(int fd, struct mmsghdr * mmsg, unsigned int vlen, unsigned int flags)`.
  /// struct mmsghdr = msghdr(28) + unsigned msg_len = 32 bytes.
  /// @nr(269)
  sendmmsg: func(fd: fd, mmsg: mmsghdr-array, vlen: u32, %flags: msg-flags) -> slong;

  /// Kernel: `sys_recvmmsg(int fd, struct mmsghdr * mmsg, unsigned int vlen, unsigned int flags, struct
  /// __kernel_timespec * timeout)`.
  /// struct mmsghdr = 32 bytes; timespec64 timeout.
  /// @nr(417)
  recvmmsg-time64: func(
    fd: fd,
    mmsg: mmsghdr-array,
    vlen: u32,
    %flags: msg-flags,
    timeout: kernel-timespec-ptr,
  ) -> slong;

  // ==== System V IPC and POSIX message queues ====

  /// Kernel: `sys_msgget(key_t key, int msgflg)`.
  /// @nr(186)
  msgget: func(key: key, msgflg: s32) -> slong;

  /// Kernel: `sys_msgctl(int msqid, int cmd, struct msqid_ds * buf)`.
  /// cmd must have IPC_64 (0x100) on most archs; musl riscv32 defines IPC_64 = 0
  /// (arch/riscv32/syscall_arch.h). struct msqid64_ds on asm-generic 32-bit: time fields split into lo/hi
  /// (msg_stime + msg_stime_high).
  /// @nr(187)
  msgctl: func(msqid: s32, cmd: s32, buf: msqid64-ds-ptr) -> slong;

  /// Kernel: `sys_msgrcv(int msqid, struct msgbuf * msgp, size_t msgsz, long msgtyp, int msgflg)`.
  /// msgbuf {long mtype; char mtext[]} - mtype is 32-bit on ILP32.
  /// @nr(188)
  msgrcv: func(msqid: s32, msgp: msgbuf-ptr, msgsz: usize, msgtyp: slong, msgflg: s32) -> slong;

  /// Kernel: `sys_msgsnd(int msqid, struct msgbuf * msgp, size_t msgsz, int msgflg)`.
  /// see msgrcv.
  /// @nr(189)
  msgsnd: func(msqid: s32, msgp: const-msgbuf-ptr, msgsz: usize, msgflg: s32) -> slong;

  /// Kernel: `sys_semget(key_t key, int nsems, int semflg)`.
  /// @nr(190)
  semget: func(key: key, nsems: s32, semflg: s32) -> slong;

  /// Kernel: `sys_semctl(int semid, int semnum, int cmd, unsigned long arg)`.
  /// 4th arg is union semun by value (unsigned long: int val or pointer). semid64_ds has split time_high
  /// fields on 32-bit.
  /// Untyped: arg: `union semun` by value: an `int`, or a pointer to `semid64-ds`, `u16[]` or `seminfo`.
  /// @nr(191)
  semctl: func(semid: s32, semnum: s32, cmd: s32, arg: ulong) -> slong;

  /// Kernel: `sys_semop(int semid, struct sembuf * tsops, unsigned int nsops)`.
  /// @nr(193)
  semop: func(semid: s32, tsops: const-sembuf-array, nsops: u32) -> slong;

  /// Kernel: `sys_semtimedop(int semid, struct sembuf * tsops, unsigned int nsops, const struct
  /// __kernel_timespec * timeout)`.
  /// musl semop uses semop; semtimedop -> semtimedop_time64.
  /// @nr(420)
  semtimedop-time64: func(
    semid: s32,
    tsops: const-sembuf-array,
    nsops: u32,
    timeout: const-kernel-timespec-ptr,
  ) -> slong;

  /// Kernel: `sys_shmget(key_t key, size_t size, int shmflg)`.
  /// @nr(194)
  shmget: func(key: key, size: usize, shmflg: s32) -> slong;

  /// Kernel: `sys_shmctl(int shmid, int cmd, struct shmid_ds * buf)`.
  /// shmid64_ds with split time high fields on 32-bit.
  /// @nr(195)
  shmctl: func(shmid: s32, cmd: s32, buf: shmid64-ds-ptr) -> slong;

  /// Kernel: `sys_shmat(int shmid, char * shmaddr, int shmflg)`.
  /// Returns attach address. SHMLBA alignment.
  /// @nr(196)
  shmat: func(shmid: s32, shmaddr: uptr, shmflg: s32) -> slong;

  /// Kernel: `sys_shmdt(char * shmaddr)`.
  /// @nr(197)
  shmdt: func(shmaddr: uptr) -> slong;

  /// Kernel: `sys_mq_open(const char * u_name, int oflag, umode_t mode, struct mq_attr * u_attr)`.
  /// struct mq_attr = 4 x long + 4 x long reserved = 32 bytes on ILP32.
  /// @nr(180)
  mq-open: func(u-name: cstr, oflag: open-flags, mode: mode, u-attr: const-mq-attr-ptr) -> slong;

  /// Kernel: `sys_mq_unlink(const char * u_name)`.
  /// @nr(181)
  mq-unlink: func(u-name: cstr) -> slong;

  /// Kernel: `sys_mq_timedsend(mqd_t mqdes, const char * u_msg_ptr, size_t msg_len, unsigned int
  /// msg_prio, const struct __kernel_timespec * u_abs_timeout)`.
  /// @nr(418)
  mq-timedsend-time64: func(
    mqdes: mqd,
    u-msg-ptr: const-buf,
    msg-len: usize,
    msg-prio: u32,
    u-abs-timeout: const-kernel-timespec-ptr,
  ) -> slong;

  /// Kernel: `sys_mq_timedreceive(mqd_t mqdes, char * u_msg_ptr, size_t msg_len, unsigned int *
  /// u_msg_prio, const struct __kernel_timespec * u_abs_timeout)`.
  /// @nr(419)
  mq-timedreceive-time64: func(
    mqdes: mqd,
    u-msg-ptr: buf,
    msg-len: usize,
    u-msg-prio: u32-ptr,
    u-abs-timeout: const-kernel-timespec-ptr,
  ) -> slong;

  /// Kernel: `sys_mq_notify(mqd_t mqdes, const struct sigevent * u_notification)`.
  /// @nr(184)
  mq-notify: func(mqdes: mqd, u-notification: const-sigevent-ptr) -> slong;

  /// Kernel: `sys_mq_getsetattr(mqd_t mqdes, const struct mq_attr * u_mqstat, struct mq_attr *
  /// u_omqstat)`.
  /// @nr(185)
  mq-getsetattr: func(mqdes: mqd, u-mqstat: const-mq-attr-ptr, u-omqstat: mq-attr-ptr) -> slong;

  // ==== Asynchronous I/O and io_uring ====

  /// Kernel: `sys_io_setup(unsigned nr_events, aio_context_t * ctxp)`.
  /// aio_context_t is __kernel_ulong_t => 32-bit on riscv32 (*ctxp is u32 on wasm32). Linux native AIO;
  /// musl does not use it (POSIX aio is thread-based).
  /// @nr(0)
  io-setup: func(nr-events: u32, ctxp: aio-context-ptr) -> slong;

  /// Kernel: `sys_io_destroy(aio_context_t ctx)`.
  /// aio_context_t is 32-bit unsigned long on riscv32.
  /// @nr(1)
  io-destroy: func(ctx: aio-context) -> slong;

  /// Kernel: `sys_io_submit(aio_context_t ctx_id, long nr, struct iocb * * iocbpp)`.
  /// struct iocb is fixed 64 bytes with explicit __u64 fields (pointer-in-u64).
  /// @nr(2)
  io-submit: func(ctx-id: aio-context, nr: slong, iocbpp: const-iocb-ptr-array) -> slong;

  /// Kernel: `sys_io_cancel(aio_context_t ctx_id, struct iocb * iocb, struct io_event * result)`.
  /// @nr(3)
  io-cancel: func(ctx-id: aio-context, iocb: iocb-ptr, %result: io-event-ptr) -> slong;

  /// Kernel: `sys_io_pgetevents(aio_context_t ctx_id, long min_nr, long nr, struct io_event * events,
  /// struct __kernel_timespec * timeout, const struct __aio_sigset * usig)`.
  /// Linux AIO; usig points to struct __aio_sigset {const sigset_t *sigmask; size_t sigsetsize} (8 bytes
  /// ILP32). Not used by musl.
  /// @nr(416)
  io-pgetevents-time64: func(
    ctx-id: aio-context,
    min-nr: slong,
    nr: slong,
    events: io-event-array,
    timeout: kernel-timespec-ptr,
    usig: const-aio-sigset-ptr,
  ) -> slong;

  /// Kernel: `sys_io_uring_setup(u32 entries, struct io_uring_params * params)`.
  /// @nr(425)
  io-uring-setup: func(entries: u32, params: io-uring-params-ptr) -> slong;

  /// Kernel: `sys_io_uring_enter(unsigned int fd, u32 to_submit, u32 min_complete, u32 flags, const void
  /// * argp, size_t argsz)`.
  /// Untyped: argp: a `sigset` or an `io-uring-getevents-arg`, depending on `flags`.
  /// @nr(426)
  io-uring-enter: func(
    fd: fd,
    to-submit: u32,
    min-complete: u32,
    %flags: u32,
    argp: const-void-ptr,
    argsz: usize,
  ) -> slong;

  /// Kernel: `sys_io_uring_register(unsigned int fd, unsigned int opcode, void * arg, unsigned int
  /// nr_args)`.
  /// Untyped: arg: pointee depends on `opcode`.
  /// @nr(427)
  io-uring-register: func(fd: fd, opcode: u32, arg: void-ptr, nr-args: u32) -> slong;

  // ==== Mounting and namespaces ====

  /// Kernel: `sys_mount(char * dev_name, char * dir_name, char * type, unsigned long flags, void *
  /// data)`.
  /// data untyped (fs-specific).
  /// Untyped: data: file system specific.
  /// @nr(40)
  mount: func(
    dev-name: cstr,
    dir-name: cstr,
    %type: cstr,
    %flags: mount-flags,
    data: const-void-ptr,
  ) -> slong;

  /// Kernel: `sys_umount(char * name, int flags)`.
  /// @nr(39)
  umount2: func(name: cstr, %flags: umount-flags) -> slong;

  /// Kernel: `sys_pivot_root(const char * new_root, const char * put_old)`.
  /// @nr(41)
  pivot-root: func(new-root: cstr, put-old: cstr) -> slong;

  /// Kernel: `sys_open_tree(int dfd, const char * filename, unsigned flags)`.
  /// @nr(428)
  open-tree: func(dfd: fd, filename: cstr, %flags: u32) -> slong;

  /// Kernel: `sys_open_tree_attr(int dfd, const char * filename, unsigned flags, struct mount_attr *
  /// uattr, size_t usize)`.
  /// @nr(467)
  open-tree-attr: func(
    dfd: fd,
    filename: cstr,
    %flags: u32,
    uattr: const-mount-attr-ptr,
    usize: usize,
  ) -> slong;

  /// Kernel: `sys_move_mount(int from_dfd, const char * from_pathname, int to_dfd, const char *
  /// to_pathname, unsigned int flags)`.
  /// @nr(429)
  move-mount: func(from-dfd: fd, from-pathname: cstr, to-dfd: fd, to-pathname: cstr, %flags: u32) -> slong;

  /// Kernel: `sys_fsopen(const char * _fs_name, unsigned int flags)`.
  /// @nr(430)
  fsopen: func(fs-name: cstr, %flags: u32) -> slong;

  /// Kernel: `sys_fsconfig(int fd, unsigned int cmd, const char * _key, const void * _value, int aux)`.
  /// Untyped: value: pointee depends on `cmd`.
  /// @nr(431)
  fsconfig: func(fd: fd, cmd: u32, key: cstr, value: const-void-ptr, aux: s32) -> slong;

  /// Kernel: `sys_fsmount(int fs_fd, unsigned int flags, unsigned int attr_flags)`.
  /// @nr(432)
  fsmount: func(fs-fd: fd, %flags: u32, attr-flags: u32) -> slong;

  /// Kernel: `sys_fspick(int dfd, const char * path, unsigned int flags)`.
  /// @nr(433)
  fspick: func(dfd: fd, path: cstr, %flags: u32) -> slong;

  /// Kernel: `sys_mount_setattr(int dfd, const char * path, unsigned int flags, struct mount_attr *
  /// uattr, size_t usize)`.
  /// @nr(442)
  mount-setattr: func(
    dfd: fd,
    path: cstr,
    %flags: at-flags,
    uattr: const-mount-attr-ptr,
    usize: usize,
  ) -> slong;

  /// Kernel: `sys_statmount(const struct mnt_id_req * req, struct statmount * buf, size_t bufsize,
  /// unsigned int flags)`.
  /// variable-size struct statmount.
  /// Untyped: buf: `struct statmount` (512+ bytes, size-versioned, not modelled).
  /// @nr(457)
  statmount: func(req: const-mnt-id-req-ptr, buf: void-ptr, bufsize: usize, %flags: u32) -> slong;

  /// Kernel: `sys_listmount(const struct mnt_id_req * req, u64 * mnt_ids, size_t nr_mnt_ids, unsigned int
  /// flags)`.
  /// struct mnt_id_req (u32 size, u32 spare/mnt_ns_fd, u64 mnt_id, u64 param, u64 mnt_ns_id).
  /// @nr(458)
  listmount: func(req: const-mnt-id-req-ptr, mnt-ids: u64-array, nr-mnt-ids: usize, %flags: u32) -> slong;

  /// Kernel: `sys_listns(const struct ns_id_req * req, u64 * ns_ids, size_t nr_ns_ids, unsigned int
  /// flags)`.
  /// @nr(470)
  listns: func(req: const-ns-id-req-ptr, ns-ids: u64-array, nr-ns-ids: usize, %flags: u32) -> slong;

  // ==== Security ====

  /// Kernel: `sys_landlock_create_ruleset(const struct landlock_ruleset_attr *const attr, const size_t
  /// size, const __u32 flags)`.
  /// @nr(444)
  landlock-create-ruleset: func(attr: const-landlock-ruleset-attr-ptr, size: usize, %flags: u32) -> slong;

  /// Kernel: `sys_landlock_add_rule(const int ruleset_fd, const enum landlock_rule_type rule_type, const
  /// void *const rule_attr, const __u32 flags)`.
  /// Untyped: rule-attr: `landlock-net-port-attr`, or the packed 12-byte `struct
  /// landlock_path_beneath_attr`.
  /// @nr(445)
  landlock-add-rule: func(ruleset-fd: fd, rule-type: s32, rule-attr: const-void-ptr, %flags: u32) -> slong;

  /// Kernel: `sys_landlock_restrict_self(const int ruleset_fd, const __u32 flags)`.
  /// @nr(446)
  landlock-restrict-self: func(ruleset-fd: fd, %flags: u32) -> slong;

  /// Kernel: `sys_lsm_get_self_attr(unsigned int attr, struct lsm_ctx * ctx, u32 * size, u32 flags)`.
  /// @nr(459)
  lsm-get-self-attr: func(attr: u32, ctx: lsm-ctx-ptr, size: u32-ptr, %flags: u32) -> slong;

  /// Kernel: `sys_lsm_set_self_attr(unsigned int attr, struct lsm_ctx * ctx, u32 size, u32 flags)`.
  /// @nr(460)
  lsm-set-self-attr: func(attr: u32, ctx: const-lsm-ctx-ptr, size: u32, %flags: u32) -> slong;

  /// Kernel: `sys_lsm_list_modules(u64 * ids, u32 * size, u32 flags)`.
  /// @nr(461)
  lsm-list-modules: func(ids: u64-array, size: u32-ptr, %flags: u32) -> slong;

  /// Kernel: `sys_add_key(const char * _type, const char * _description, const void * _payload, size_t
  /// plen, key_serial_t ringid)`.
  /// @nr(217)
  add-key: func(
    %type: cstr,
    description: cstr,
    payload: const-void-ptr,
    plen: usize,
    ringid: key-serial,
  ) -> slong;

  /// Kernel: `sys_request_key(const char * _type, const char * _description, const char * _callout_info,
  /// key_serial_t destringid)`.
  /// @nr(218)
  request-key: func(%type: cstr, description: cstr, callout-info: cstr, destringid: key-serial) -> slong;

  /// Kernel: `sys_keyctl(int option, unsigned long arg2, unsigned long arg3, unsigned long arg4, unsigned
  /// long arg5)`.
  /// Untyped args depending on option.
  /// Untyped: arg2..arg5: integers or guest pointers, depending on `option`.
  /// @nr(219)
  keyctl: func(%option: s32, arg2: ulong, arg3: ulong, arg4: ulong, arg5: ulong) -> slong;

  /// Kernel: `sys_bpf(int cmd, union bpf_attr * uattr, unsigned int size, struct bpf_common_attr *
  /// uattr_common, unsigned int size_common)`.
  /// Kernel 7.x prototype has 5 args (cmd, attr, size, uattr_common, size_common); older kernels 3 args.
  /// Untyped: uattr/uattr-common: `union bpf_attr`/`struct bpf_common_attr`, size-versioned, not
  /// modelled.
  /// @nr(280)
  bpf: func(cmd: s32, uattr: void-ptr, size: u32, uattr-common: void-ptr, size-common: u32) -> slong;

  /// Kernel: `sys_perf_event_open(struct perf_event_attr * attr_uptr, pid_t pid, int cpu, int group_fd,
  /// unsigned long flags)`.
  /// struct perf_event_attr size-versioned.
  /// Untyped: attr-uptr: `struct perf_event_attr` (size-versioned, not modelled).
  /// @nr(241)
  perf-event-open: func(attr-uptr: void-ptr, pid: pid, cpu: s32, group-fd: fd, %flags: ulong) -> slong;

  // ==== System administration ====

  /// Kernel: `sys_reboot(int magic1, int magic2, unsigned int cmd, void * arg)`.
  /// magic numbers required.
  /// Untyped: arg: only used by `LINUX_REBOOT_CMD_RESTART2` (a string).
  /// @nr(142)
  reboot: func(magic1: s32, magic2: s32, cmd: reboot-cmd, arg: void-ptr) -> slong;

  /// Kernel: `sys_acct(const char * name)`.
  /// @nr(89)
  acct: func(name: cstr) -> slong;

  /// Kernel: `sys_swapon(const char * specialfile, int swap_flags)`.
  /// @nr(224)
  swapon: func(specialfile: cstr, swap-flags: s32) -> slong;

  /// Kernel: `sys_swapoff(const char * specialfile)`.
  /// @nr(225)
  swapoff: func(specialfile: cstr) -> slong;

  /// Kernel: `sys_syslog(int type, char * buf, int len)`.
  /// klogctl.
  /// @nr(116)
  syslog: func(%type: s32, buf: buf, len: s32) -> slong;

  /// Kernel: `sys_vhangup()`.
  /// @nr(58)
  vhangup: func() -> slong;

  /// Kernel: `sys_kexec_load(unsigned long entry, unsigned long nr_segments, struct kexec_segment *
  /// segments, unsigned long flags)`.
  /// @nr(104)
  /// @unsupported
  kexec-load: func(
    entry: uptr,
    nr-segments: ulong,
    segments: const-kexec-segment-array,
    %flags: ulong,
  ) -> slong;

  /// Kernel: `sys_kexec_file_load(int kernel_fd, int initrd_fd, unsigned long cmdline_len, const char *
  /// cmdline_ptr, unsigned long flags)`.
  /// @nr(294)
  /// @unsupported
  kexec-file-load: func(
    kernel-fd: fd,
    initrd-fd: fd,
    cmdline-len: ulong,
    cmdline-ptr: cstr,
    %flags: ulong,
  ) -> slong;

  /// Kernel: `sys_init_module(void * umod, unsigned long len, const char * uargs)`.
  /// @nr(105)
  /// @unsupported
  init-module: func(umod: const-buf, len: ulong, uargs: cstr) -> slong;

  /// Kernel: `sys_finit_module(int fd, const char * uargs, int flags)`.
  /// @nr(273)
  /// @unsupported
  finit-module: func(fd: fd, uargs: cstr, %flags: s32) -> slong;

  /// Kernel: `sys_delete_module(const char * name_user, unsigned int flags)`.
  /// @nr(106)
  /// @unsupported
  delete-module: func(name-user: cstr, %flags: u32) -> slong;
}
