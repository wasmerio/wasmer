  // ==== Futexes ====

  /// Kernel: `sys_futex(u32 * uaddr, int op, u32 val, const struct __kernel_timespec * utime, u32 *
  /// uaddr2, u32 val3)`.
  /// riscv32 has no plain `futex`; musl defines `SYS_futex` as `SYS_futex_time64`. The timeout is
  /// relative for `FUTEX_WAIT` and absolute for `FUTEX_WAIT_BITSET`/`FUTEX_LOCK_PI2`.
  /// Untyped: utime: a pointer to `kernel-timespec` for the waiting ops, but reinterpreted as the `u32`
  /// `val2` for `FUTEX_REQUEUE`, `FUTEX_CMP_REQUEUE*` and `FUTEX_WAKE_OP`.
  /// @nr(422)
  futex-time64: func(
    uaddr: u32-ptr,
    op: futex-op,
    val: u32,
    utime: ulong,
    uaddr2: u32-ptr,
    val3: u32,
  ) -> slong;

  /// Kernel: `sys_futex_waitv(struct futex_waitv * waiters, unsigned int nr_futexes, unsigned int flags,
  /// struct __kernel_timespec * timeout, clockid_t clockid)`.
  /// struct futex_waitv {u64 val; u64 uaddr; u32 flags; u32 __reserved} 24 bytes (uaddr as u64 even on
  /// 32-bit).
  /// @nr(449)
  futex-waitv: func(
    waiters: const-futex-waitv-array,
    nr-futexes: u32,
    %flags: u32,
    timeout: kernel-timespec-ptr,
    clockid: clock-id,
  ) -> slong;

  /// Kernel: `sys_futex_wake(void * uaddr, unsigned long mask, int nr, unsigned int flags)`.
  /// futex2 API (6.7+). mask is unsigned long (32-bit on riscv32).
  /// @nr(454)
  futex-wake: func(uaddr: u32-ptr, mask: ulong, nr: s32, %flags: futex2-flags) -> slong;

  /// Kernel: `sys_futex_wait(void * uaddr, unsigned long val, unsigned long mask, unsigned int flags,
  /// struct __kernel_timespec * timeout, clockid_t clockid)`.
  /// futex2 API; val/mask unsigned long.
  /// @nr(455)
  futex-wait: func(
    uaddr: u32-ptr,
    val: ulong,
    mask: ulong,
    %flags: futex2-flags,
    timeout: kernel-timespec-ptr,
    clockid: clock-id,
  ) -> slong;

  /// Kernel: `sys_futex_requeue(struct futex_waitv * waiters, unsigned int flags, int nr_wake, int
  /// nr_requeue)`.
  /// Takes array of 2 struct futex_waitv.
  /// @nr(456)
  futex-requeue: func(waiters: const-futex-waitv-array, %flags: u32, nr-wake: s32, nr-requeue: s32) -> slong;

  // ==== Memory management ====

  /// Kernel: `sys_brk(unsigned long brk)`.
  /// Returns new break (or current break on failure), never -errno. musl malloc-ng only uses brk to
  /// probe/extend (lite_malloc/mallocng expand_heap).
  /// @nr(214)
  brk: func(brk: uptr) -> slong;

  /// Kernel: `sys_mmap2(unsigned long addr, unsigned long len, unsigned long prot, unsigned long flags,
  /// unsigned long fd, unsigned long offset)`.
  /// riscv32 has only mmap2 (no mmap): offset is in units of 4096 bytes (riscv sys_mmap2 uses a constant
  /// shift of 12 regardless of PAGE_SIZE), NOT bytes. musl passes off/4096 (UNIT=4096) and rejects off
  /// not multiple of 4096. Wasm: page size mismatch (wasm pages 64KiB; Linux 4KiB) - host design needed.
  /// Returns address.
  /// @nr(222)
  mmap2: func(addr: uptr, len: ulong, prot: prot-flags, %flags: map-flags, fd: fd, offset: ulong) -> slong;

  /// Kernel: `sys_munmap(unsigned long addr, size_t len)`.
  /// @nr(215)
  munmap: func(addr: uptr, len: usize) -> slong;

  /// Kernel: `sys_mremap(unsigned long addr, unsigned long old_len, unsigned long new_len, unsigned long
  /// flags, unsigned long new_addr)`.
  /// 5th arg new_addr only with MREMAP_FIXED; returns address.
  /// @nr(216)
  mremap: func(addr: uptr, old-len: ulong, new-len: ulong, %flags: mremap-flags, new-addr: uptr) -> slong;

  /// Kernel: `sys_mprotect(unsigned long start, size_t len, unsigned long prot)`.
