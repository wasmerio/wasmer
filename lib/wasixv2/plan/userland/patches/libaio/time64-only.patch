diff --git a/src/io_pgetevents.c b/src/io_pgetevents.c
index e6b0614..f54f077 100644
--- a/src/io_pgetevents.c
+++ b/src/io_pgetevents.c
@@ -21,10 +21,46 @@
 #include <stdlib.h>
 #include <time.h>
 #include <signal.h>
+#include <stdint.h>
 #include "syscall.h"
 #include "aio_ring.h"
 
-#ifdef __NR_io_pgetevents
+#if !defined(__NR_io_pgetevents) && defined(__NR_io_pgetevents_time64)
+/* A kernel timespec always has two signed 64-bit fields. The public
+ * timespec may have 32-bit seconds or nanoseconds/padding: never pass it
+ * directly to the time64 syscall (Linux kernel/time/time.c:get_timespec64).
+ */
+struct aio_timespec64 {
+	int64_t tv_sec;
+	int64_t tv_nsec;
+};
+
+io_syscall6(int, __io_pgetevents_time64, io_pgetevents_time64, io_context_t,
+		ctx, long, min_nr, long, nr, struct io_event *, events,
+		struct aio_timespec64 *, timeout, void *, sigmask);
+
+int io_pgetevents(io_context_t ctx, long min_nr, long nr,
+		struct io_event *events, struct timespec *timeout,
+		sigset_t *sigmask)
+{
+	struct aio_timespec64 ts;
+	struct {
+		unsigned long ss;
+		unsigned long ss_len;
+	} data;
+
+	if (aio_ring_is_empty(ctx, timeout))
+		return 0;
+	if (timeout) {
+		ts.tv_sec = timeout->tv_sec;
+		ts.tv_nsec = timeout->tv_nsec;
+	}
+	data.ss = (unsigned long)sigmask;
+	data.ss_len = _NSIG / 8;
+	return __io_pgetevents_time64(ctx, min_nr, nr, events,
+			timeout ? &ts : NULL, &data);
+}
+#elif defined(__NR_io_pgetevents)
 io_syscall6(int, __io_pgetevents, io_pgetevents, io_context_t, ctx, long,
 		min_nr, long, nr, struct io_event *, events,
 		struct timespec *, timeout, void *, sigmask);
