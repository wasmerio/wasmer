 io_syscall5(int, __io_getevents_0_4, io_getevents, io_context_t, ctx, long, min_nr, long, nr, struct io_event *, events, struct timespec *, timeout)
 
+#else
+/* Linux fs/aio.c:io_pgetevents_time64 has the same event-wait semantics
+ * as io_getevents, with an optional signal mask. Time64-only architectures
+ * have no legacy io_getevents syscall. */
+static int __io_getevents_0_4(io_context_t ctx, long min_nr, long nr,
+		struct io_event *events, struct timespec *timeout)
+{
+	return io_pgetevents(ctx, min_nr, nr, events, timeout, NULL);
+}
+#endif
