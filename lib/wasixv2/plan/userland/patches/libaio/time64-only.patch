diff --git a/harness/cases/24.t b/harness/cases/24.t
new file mode 100644
index 0000000..7e7851b
--- /dev/null
+++ b/harness/cases/24.t
@@ -0,0 +1,60 @@
+// SPDX-License-Identifier: LGPL-2.1+
+/* Time64-only Linux AIO: fs/aio.c:SYSCALL_DEFINE6(io_pgetevents_time64).
+ * Exercise public timespec conversion and restoration of the temporary mask.
+ */
+#include <limits.h>
+#include <signal.h>
+#include <stdint.h>
+#include <time.h>
+
+static volatile sig_atomic_t handled;
+static void handler(int sig) { handled = sig; }
+
+int test_main(void)
+{
+	io_context_t ctx = 0;
+	struct io_event event;
+	struct timespec timeout = { 0, 1000000000 };
+	struct sigaction action = { .sa_handler = handler };
+	sigset_t blocked, empty, saved;
+	int ret;
+
+	assert(io_setup(1, &ctx) == 0);
+	errno = EDOM;
+	ret = io_pgetevents(ctx, -1, 1, &event, &timeout, NULL);
+	if (ret != -EINVAL) {
+		fprintf(stderr, "io_pgetevents invalid min_nr: %d, expected %d\n", ret, -EINVAL);
+		return 1;
+	}
+	assert(errno == EDOM);
+	/* fs/aio.c:do_io_getevents normalizes the timespec, rather than
+	 * rejecting a nanosecond field of 1000000000. min_nr=0 never waits. */
+	assert(io_pgetevents(ctx, 0, 1, &event, &timeout, NULL) == 0);
+	assert(timeout.tv_nsec == 1000000000);
+	if (sizeof(time_t) > 4) {
+		timeout.tv_sec = (time_t)((int64_t)INT32_MAX + 1);
+		timeout.tv_nsec = 123;
+		assert(io_pgetevents(ctx, 0, 1, &event, &timeout, NULL) == 0);
+		assert(timeout.tv_sec == (int64_t)INT32_MAX + 1);
+		assert(timeout.tv_nsec == 123);
+	}
+
+	sigemptyset(&action.sa_mask);
+	assert(sigaction(SIGUSR1, &action, NULL) == 0);
+	sigemptyset(&blocked);
+	sigaddset(&blocked, SIGUSR1);
+	sigemptyset(&empty);
+	assert(sigprocmask(SIG_BLOCK, &blocked, &saved) == 0);
+	assert(kill(getpid(), SIGUSR1) == 0);
+	timeout.tv_sec = 1;
+	timeout.tv_nsec = 0;
+	errno = EDOM;
+	assert(io_pgetevents(ctx, 1, 1, &event, &timeout, &empty) == -EINTR);
+	assert(errno == EDOM);
+	assert(handled == SIGUSR1);
+	assert(sigprocmask(SIG_SETMASK, NULL, &blocked) == 0);
+	assert(sigismember(&blocked, SIGUSR1) == 1);
+	assert(sigprocmask(SIG_SETMASK, &saved, NULL) == 0);
+	assert(io_destroy(ctx) == 0);
+	return 0;
+}
diff --git a/harness/cases/25.t b/harness/cases/25.t
new file mode 100644
index 0000000..f0e7094
--- /dev/null
+++ b/harness/cases/25.t
@@ -0,0 +1,28 @@
+// SPDX-License-Identifier: LGPL-2.1+
+/* io_getevents must work without legacy __NR_io_getevents on time64-only Linux. */
+#include <limits.h>
+#include <stdint.h>
+#include <time.h>
+
+int test_main(void)
+{
+	io_context_t ctx = 0;
+	struct io_event event;
+	struct timespec timeout = { 0, 1000000000 };
+
+	assert(io_setup(1, &ctx) == 0);
+	errno = EDOM;
+	assert(io_getevents(ctx, -1, 1, &event, &timeout) == -EINVAL);
+	assert(errno == EDOM);
+	assert(io_getevents(ctx, 0, 1, &event, &timeout) == 0);
+	assert(timeout.tv_nsec == 1000000000);
+	if (sizeof(time_t) > 4) {
+		timeout.tv_sec = (time_t)((int64_t)INT32_MAX + 1);
+		timeout.tv_nsec = 123;
+		assert(io_getevents(ctx, 0, 1, &event, &timeout) == 0);
+		assert(timeout.tv_sec == (int64_t)INT32_MAX + 1);
+		assert(timeout.tv_nsec == 123);
+	}
+	assert(io_destroy(ctx) == 0);
+	return 0;
+}
